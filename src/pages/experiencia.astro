<script>
  document.querySelectorAll<HTMLElement>('.exp-col').forEach((col) => {
    const btn = col.querySelector<HTMLButtonElement>('.expand-toggle');
    if (!btn) return;

    const getDetails = () => col.querySelectorAll<HTMLDetailsElement>('details');

    const syncLabel = () => {
      const all = getDetails();
      const allOpen = [...all].every((d) => d.open);
      btn.textContent = allOpen ? 'Colapsar todo ↑' : 'Expandir todo ↓';
    };

    btn.addEventListener('click', () => {
      const all = getDetails();
      const allOpen = [...all].every((d) => d.open);
      all.forEach((d) => { d.open = !allOpen; });
      syncLabel();
    });

    // Sincronizar label cuando se abre/cierra un accordion individual
    getDetails().forEach((d) => d.addEventListener('toggle', syncLabel));

    // Estado inicial
    syncLabel();
  });
</script>

<script>
  // Carrusel de certificados y badges
  function initCarousel(outer: HTMLElement) {
    const track = outer.querySelector<HTMLElement>('.carousel-track');
    const prev = outer.querySelector<HTMLButtonElement>('.carousel-btn--prev');
    const next = outer.querySelector<HTMLButtonElement>('.carousel-btn--next');
    if (!track || !prev || !next) return;

    const step = (): number => {
      const item = track.querySelector<HTMLElement>('.carousel-item');
      if (!item) return 200;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
      return item.offsetWidth + gap;
    };

    const sync = () => {
      prev.hidden = track.scrollLeft <= 1;
      next.hidden = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });

    sync();
  }

  document.querySelectorAll<HTMLElement>('.carousel-outer').forEach(initCarousel);
</script>

<script>
  // ─────────────────────────────────────────────────────
  // LIGHTBOX para los carruseles de certificados y badges
  // ─────────────────────────────────────────────────────
  (() => {
    const lightbox = document.getElementById('cert-lightbox') as HTMLElement | null;
    if (!lightbox) return;

    const imgEl     = document.getElementById('cert-lightbox-img')     as HTMLImageElement;
    const captionEl = document.getElementById('cert-lightbox-caption') as HTMLElement;
    const closeBtn  = document.getElementById('cert-lightbox-close')   as HTMLButtonElement;
    const prevBtn   = document.getElementById('cert-lightbox-prev')    as HTMLButtonElement;
    const nextBtn   = document.getElementById('cert-lightbox-next')    as HTMLButtonElement;

    let currentList: HTMLImageElement[] = [];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function render() {
      const img = currentList[currentIndex];
      if (!img) return;
      imgEl.src = img.src;
      imgEl.alt = img.alt || '';
      captionEl.textContent = img.alt || '';
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex === currentList.length - 1;
    }

    function open(list: HTMLImageElement[], index: number, trigger: HTMLElement) {
      currentList = list;
      currentIndex = index;
      lastFocused = trigger;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if (lastFocused) lastFocused.focus();
    }

    function prev() { if (currentIndex > 0) { currentIndex--; render(); } }
    function next() { if (currentIndex < currentList.length - 1) { currentIndex++; render(); } }

    // Wire los items de cada carrusel
    document.querySelectorAll<HTMLElement>('.carousel-track--certs, .carousel-track--badges').forEach((track) => {
      const items = Array.from(track.querySelectorAll<HTMLImageElement>('.carousel-item img'));
      items.forEach((img, i) => {
        const item = img.closest<HTMLElement>('.carousel-item');
        if (!item) return;
        item.setAttribute('tabindex', '0');
        item.setAttribute('role', 'button');
        item.setAttribute('aria-label', img.alt ? `Ver: ${img.alt}` : 'Ver imagen');
        const trigger = () => open(items, i, item);
        item.addEventListener('click', trigger);
        item.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger(); }
        });
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    // Click fuera de la figure cierra
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    // Teclado: ESC cierra, flechas navegan
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape')         close();
      else if (e.key === 'ArrowLeft')  prev();
      else if (e.key === 'ArrowRight') next();
    });
  })();
</script>
