</Layout>

<!-- Estilos del slot de Accordion (is:global para atravesar el componente) -->
<style is:global>
  .acc-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .acc-bullets li {
    padding-left: 1.5rem;
    position: relative;
    color: #c0c0c0;
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .acc-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #444;
  }

  .acc-desc {
    color: #808080;
    font-size: 0.875rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .acc-ia-block .acc-desc {
    margin-bottom: 0.75rem;
  }

  .acc-ia-block {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #1e1e1e;
  }

  .acc-ia-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4a4a4a;
    margin-bottom: 0.85rem;
  }

  .skills-group {
    margin-bottom: 1.5rem;
  }

  .skills-group:last-child {
    margin-bottom: 0;
  }

  .skills-group-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4a4a4a;
