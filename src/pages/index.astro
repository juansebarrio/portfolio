---
import Layout from '../layouts/Layout.astro';
import PasswordGate from '../components/PasswordGate.astro';

const marqueeText = 'Data · People · Tech · AI · Design · ';

// YouTube — Reconocimiento en la Legislatura
const legislaturaVideoId = 'cLVTwzJwieo';

// Casos corporativos bajo NDA (detrás de candado)
const casosGalicia = [
  {
    href: '/portfolio/csat-semantico',
    meta: 'Banco Galicia · 2026 · IA + Research',
    titulo: 'De 10.000 opiniones a un backlog priorizado',
  },
  {
    href: '/portfolio/upgrade',
    meta: 'Banco Galicia · 2026 · Product Design',
    titulo: 'El upgrade más rápido del sistema financiero argentino',
  },
  {
    href: '/portfolio/rediseno-cuentas',
    meta: 'Banco Galicia · 2025 · Rediseño',
    titulo: 'Diseñando cuentas desde cero',
    preview: '/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg',
    previewAlt: 'Taller de alineación entre bancas: equipo revisando pantallas del rediseño en monitores grandes',
  },
  {
    href: '/portfolio/pfm',
    meta: 'Banco Galicia · 2024 · Product Design',
    titulo: 'El primer PFM argentino hecho por un banco',
    preview: '/images/portfolio/pfm/pfm-card-preview.jpg',
    previewAlt: 'Testeo guerrilla en sucursal: una persona usando el PFM en el celular mientras el equipo toma notas',
  },
];

// Subject del mailto de "Solicitar acceso"
const mailtoAcceso = `mailto:contacto@juansebarrio.com?subject=${encodeURIComponent('Acceso al portfolio completo')}&body=${encodeURIComponent('Hola Juanse,\n\nMe gustaría ver los casos bajo NDA del portfolio.\n\nGracias,\n')}`;
---

<Layout title="Juanse Barrio — Inicio" description="Portafolio de Juan Segundo Barrio, AI Product Designer.">

  <!-- ── HERO ── -->
  <section class="hero">

    <!-- Marquee fantasma de fondo -->
    <div class="hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...Array(3)].map(() => (
          <span class="marquee-bg-item">{marqueeText}</span>
        ))}
      </div>
    </div>

    <!-- Contenido -->
    <div class="hero-content">

      <div class="hero-heading">
        <h1 class="hero-title">AI Product Designer</h1>
        <p class="hero-subtitle">NGO Vice President&nbsp;·&nbsp;Diversity &amp; Inclusion</p>
      </div>

      <p class="hero-bio">
        La tecnología siempre fue parte de mi historia. Hoy diseño productos digitales
        que nacen de esa misma pasión: crear experiencias útiles, humanas y significativas.
      </p>

      <div class="hero-buttons">
        <a href="/portfolio" class="btn-primary">Ver portfolio</a>
        <a href="/experiencia" class="btn-text">Mi experiencia →</a>
      </div>

    </div>
  </section>

  <!-- ── SECCIÓN TALLER ── -->
  <section class="taller-section">
    <div class="taller-grid">

      <figure class="taller-foto fade-in">
        <img src="/images/about/galicia-taller.png" alt="Foto de taller de trabajo" />
      </figure>

      <div class="taller-texto fade-in">
        <blockquote class="taller-frase">
          Diseño con foco en IA. Research, experimentación y entrega de productos que usan personas reales, cada día.
        </blockquote>
        <p class="taller-rol">
          Creo que la simbiosis entre humanos y tecnología refleja nuestro innato deseo de evolución. Mi aporte es diseñar productos que usen esa mezcla para mejorar la vida real de las personas.
        </p>
      </div>

    </div>
  </section>

  <!-- ── TRABAJO PÚBLICO ── -->
  <section class="publico-section">
    <div class="home-container">

      <div class="publico-header fade-in">
        <p class="section-eyebrow">Trabajo público</p>
        <h2 class="casos-title">Más allá del banco</h2>
        <p class="publico-intro">
          Proyectos abiertos donde diseño, comunicación y propósito se cruzan. Impulse (AHF) y docencia en UdeSA.
        </p>
      </div>

      <!-- PIEZA DESTACADA: Legislatura -->
      <article class="destacado fade-in">
        <div class="destacado-media">
          <img
            src="/images/impulse/legislatura-diploma.jpg"
            alt="Diploma de reconocimiento de la Legislatura de la Ciudad Autónoma de Buenos Aires por participación en la exposición Celebramos el Orgullo"
            loading="lazy"
          />
        </div>

        <div class="destacado-texto">
          <p class="destacado-eyebrow">Legislatura CABA · 2024 · Reconocimiento institucional</p>
          <h3 class="destacado-titulo">Celebramos el Orgullo</h3>
          <p class="destacado-bajada">
            Serie fotográfica seleccionada para la exposición institucional de la Legislatura Porteña durante la Semana del Orgullo. Reconocida por la Dirección General de Derechos Humanos.
          </p>

          <ul class="destacado-meta">
            <li><strong>9</strong><span>obras exhibidas</span></li>
            <li><strong>Oficial</strong><span>Legislatura CABA</span></li>
            <li><strong>DDHH</strong><span>Dirección General</span></li>
          </ul>

          <details class="destacado-reveal">
            <summary>
              <span class="reveal-label-open">Ver obras y video del reconocimiento</span>
              <span class="reveal-label-close">Ocultar</span>
              <span class="reveal-arrow" aria-hidden="true">↓</span>
            </summary>

            <div class="reveal-content">
              <div class="reveal-video">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${legislaturaVideoId}`}
                  title="Reconocimiento en la Legislatura CABA — Juan Segundo Barrio"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>

              <p class="reveal-obras-label">Obras exhibidas · Serie VIH/VIR</p>
              <div class="reveal-obras">
                <img src="/images/impulse/obra-1-vihvir.jpg" alt="Obra 1 — VIH/VIR" loading="lazy" />
                <img src="/images/impulse/obra-2-vihvir.jpg" alt="Obra 2 — VIH/VIR" loading="lazy" />
                <img src="/images/impulse/obra-3-vihvir.jpg" alt="Obra 3 — VIH/VIR" loading="lazy" />
                <img src="/images/impulse/obra-4-vihvir.jpg" alt="Obra 4 — VIH/VIR" loading="lazy" />
              </div>
            </div>
          </details>
        </div>
      </article>

      <!-- GRILLA SECUNDARIA: Marcha · Chatbot · UdeSA -->
      <div class="publico-grid">

        <article class="publico-card fade-in">
          <div class="publico-img">
            <img
              src="/images/impulse/pride-congreso-noche.jpg"
              alt="Carroza de Impulse en la Marcha del Orgullo 2025 con el Congreso de fondo"
              loading="lazy"
            />
          </div>
          <p class="caso-meta">Marcha del Orgullo 2025 · Impulse</p>
          <h3 class="caso-titulo">Hablemos de VIH</h3>
          <p class="publico-bajada">
            Dirección creativa de carroza y campaña de concientización en la Marcha del Orgullo CABA.
          </p>
        </article>

        <article class="publico-card fade-in">
          <div class="publico-img">
            <img
              src="/images/impulse/chatbot-presentacion.jpg"
              alt="Juanse presentando el chatbot Indetectable = Intransmisible"
              loading="lazy"
            />
          </div>
          <p class="caso-meta">Producto digital · Impulse</p>
          <h3 class="caso-titulo">Indetectable = Intransmisible</h3>
          <p class="publico-bajada">
            Chatbot de información sobre VIH y acceso a la red de prevención de Impulse.
          </p>
        </article>

        <article class="publico-card fade-in">
          <div class="publico-img">
            <img
              src="/images/udesa/udesa-ux-day.jpg"
              alt="Juanse dando clase en la UdeSA"
              loading="lazy"
            />
          </div>
          <p class="caso-meta">Docencia · 2023–2024</p>
          <h3 class="caso-titulo">Diseño UX en UdeSA</h3>
          <p class="publico-bajada">
            Profesor adjunto de Diseño UX para la Lic. en Negocios Digitales. 20–30 alumnos por camada.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- ── CASOS CORPORATIVOS · GALICIA (con candado) ── -->
  <section class="corp-section">
    <div class="home-container">

      <div class="corp-header fade-in">
        <p class="section-eyebrow">Casos corporativos</p>
        <h2 class="casos-title">Proyectos bajo NDA</h2>
        <p class="corp-intro">
          Cuatro casos de Banco Galicia con acceso restringido por confidencialidad. Escribime si querés revisarlos y te comparto el acceso.
        </p>
      </div>

      <div class="corp-grid">
        {casosGalicia.map((c) => (
          <a href={c.href} class="caso-card caso-card-locked fade-in" data-requires-auth aria-label={`${c.titulo} — acceso restringido`}>
            <div class="caso-img corp-img">
              {c.preview && (
                <img src={c.preview} alt="" class="caso-preview-blurred" aria-hidden="true" loading="lazy" />
              )}
              <div class="lock-overlay">
                <svg class="lock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="5" y="11" width="14" height="10" rx="1.5" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <span class="lock-label">Acceso restringido</span>
              </div>
            </div>
            <p class="caso-meta">{c.meta}</p>
            <p class="caso-titulo">
              {c.titulo}
              <span class="caso-arrow" aria-hidden="true">→</span>
            </p>
          </a>
        ))}
      </div>

      <div class="corp-cta fade-in">
        <a href={mailtoAcceso} class="btn-primary">Solicitar acceso al portfolio completo</a>
        <a href="/portfolio" class="btn-text">Ir al índice →</a>
      </div>

    </div>
  </section>

  <PasswordGate />

  <script>
    document.querySelectorAll('[data-requires-auth]').forEach(link => {
      link.addEventListener('click', (e) => {
        if (sessionStorage.getItem('portfolio-auth') === 'true') return;
        e.preventDefault();
        const target = (link as HTMLAnchorElement).getAttribute('href');
        window.__showPasswordGate?.(target);
      });
    });
  </script>

  <!-- ── MÓDULO JS80 ── -->
  <section class="js80-module">
    <div class="js80-module-inner home-container">
      <div class="js80-module-content">
        <div class="js80-module-logo">
          <div class="js80-sphere-sm" aria-hidden="true">
            <div class="js80-sphere"></div>
          </div>
          <div class="js80-logo-text">
            <span class="js80-wm">js80</span>
            <span class="js80-dot-sep" aria-hidden="true">·</span>
            <span class="js80-tag-label">estudio de soluciones digitales</span>
          </div>
        </div>
        <p class="js80-module-desc">
          El mismo rigor del producto corporativo, aplicado a negocios reales.
          Sin jerga. Sin vueltas.
        </p>
        <a href="/js80" class="js80-module-btn">Conocer el estudio →</a>
      </div>
      <div class="js80-module-visual" aria-hidden="true">
        <div class="js80-sphere-wrap">
          <div class="js80-sphere"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA CONTACTO ── -->
  <section class="cta-section">
    <div class="home-container">
      <p class="section-eyebrow">Contacto</p>
      <h2 class="cta-title">¿Conversamos?</h2>
      <p class="cta-body">
        Estoy abierto a oportunidades como Product Designer con foco en IA.
        También me interesan colaboraciones con organizaciones sociales y proyectos
        que mezclen tecnología y propósito. Cuento con autorización para trabajar
        en todo el Mercosur y la Unión Europea, tanto de manera autónoma como en
        relación de dependencia.
      </p>
      <div class="cta-links">
        <a href="mailto:contacto@juansebarrio.com" class="cta-link">
          contacto@juansebarrio.com&nbsp;↗
        </a>
        <span class="cta-sep" aria-hidden="true">·</span>
        <a
          href="https://www.linkedin.com/in/juansebarrio"
          class="cta-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn&nbsp;↗
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─────────────────────────────
     HERO
  ───────────────────────────── */
  .hero {
    position: relative;
    height: calc(100vh - 64px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-marquee {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    opacity: 0.08;
  }

  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: marquee 28s linear infinite;
    will-change: transform;
  }

  .marquee-bg-item {
    flex-shrink: 0;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: #f0f0f0;
    padding-right: 2rem;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding-left: 4rem;
    padding-right: 2rem;
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-title {
    font-family: 'Syne', system-ui, sans-serif !important;
    font-size: clamp(2.5rem, 6vw, 5rem) !important;
    font-weight: 700 !important;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f0f0f0;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    font-weight: 500;
    color: #6b6b6b;
    margin: 0;
  }

  .hero-bio {
    color: #a0a0a0;
    line-height: 1.75;
    font-size: 1rem;
    max-width: 38ch;
    margin: 0;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #f0f0f0;
    background-color: #141414;
    border: 1px solid rgba(240, 240, 240, 0.15);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .btn-primary:hover {
    border-color: rgba(240, 240, 240, 0.4);
  }

  .btn-text {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b6b6b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-text:hover {
    color: #f0f0f0;
  }

  /* ─────────────────────────────
     SECCIÓN TALLER
  ───────────────────────────── */
  .taller-section {
    padding: 6rem 0;
    min-height: 60vh;
    display: flex;
    justify-content: center;
    align-items: center;
    border-top: 1px solid rgba(240, 240, 240, 0.06);
  }

  .taller-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .taller-foto {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .taller-foto img {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 70vh;
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }

  .taller-texto {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .taller-frase {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #e0e0e0;
    margin: 0;
    quotes: none;
  }

  .taller-rol {
    font-size: 0.75rem;
    font-weight: 400;
    color: #555;
    line-height: 1.6;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ─────────────────────────────
     FADE-IN con Intersection Observer
  ───────────────────────────── */
  .fade-in {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─────────────────────────────
     ANIMACIÓN MARQUEE
  ───────────────────────────── */
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }

  /* ─────────────────────────────
     TOKENS COMUNES (casos + público + corp)
  ───────────────────────────── */
  .home-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }

  .section-eyebrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 1rem;
  }

  .casos-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: #f0f0f0;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .caso-meta {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 0.5rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .caso-titulo {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 500;
    color: #f0f0f0;
    line-height: 1.2;
    margin: 0;
    transition: color 300ms ease;
  }

  .caso-placeholder {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .caso-img {
    aspect-ratio: 4 / 3;
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    overflow: hidden;
    transition: filter 300ms ease, border-color 300ms ease;
  }

  .caso-img img,
  .caso-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caso-arrow {
    opacity: 0;
    margin-left: 0.5rem;
    display: inline-block;
    transition: opacity 300ms ease;
  }

  /* ─────────────────────────────
     TRABAJO PÚBLICO
  ───────────────────────────── */
  .publico-section {
    padding: clamp(4rem, 10vw, 8rem) 0;
    border-top: 1px solid rgba(240, 240, 240, 0.06);
  }

  .publico-header {
    max-width: 48rem;
    margin-bottom: 4rem;
  }

  .publico-intro {
    font-size: 1rem;
    color: #a0a0a0;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    max-width: 42rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* Pieza destacada: Legislatura */
  .destacado {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 4rem;
    align-items: start;
    padding: 3rem;
    margin-bottom: 5rem;
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
  }

  .destacado-media {
    border-radius: 10px;
    overflow: hidden;
    background: #0a0a0a;
  }

  .destacado-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .destacado-eyebrow {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 1rem;
  }

  .destacado-titulo {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: #f0f0f0;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  .destacado-bajada {
    font-size: 1rem;
    color: #a0a0a0;
    line-height: 1.6;
    margin: 0 0 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .destacado-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 2.5rem;
    padding: 0;
    margin: 0 0 2rem;
    list-style: none;
    border-top: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    padding-block: 1.25rem;
  }

  .destacado-meta li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .destacado-meta strong {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #f0f0f0;
    letter-spacing: -0.01em;
  }

  .destacado-meta span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  /* Reveal de obras + video */
  .destacado-reveal {
    margin-top: 0.5rem;
  }

  .destacado-reveal > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.25rem;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #f0f0f0;
    background-color: #0a0a0a;
    border: 1px solid rgba(240, 240, 240, 0.15);
    border-radius: 2px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
