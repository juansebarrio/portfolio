---
import LayoutJS80 from '../../../layouts/LayoutJS80.astro';

export const prerender = false;
---

<LayoutJS80
  title="Digital Appointment System · JS80"
  description="End-to-end scheduling system built for medical practices."
>

  <!-- ── Hero ── -->
  <div class="case-hero">
    <div class="case-hero-inner">
      <div class="case-tags">
        <span class="tag">Health</span>
        <span class="tag">Scheduling</span>
        <span class="tag">SecretarIA</span>
      </div>
      <h1 class="serif case-title">Digital appointment system.</h1>
      <p class="case-subtitle">
        Your patient books in 30 seconds. Your schedule organizes itself — no app to download,
        no endless forms, no secretary spending all day on the phone.
      </p>
    </div>
  </div>

  <!-- ── Preview ── -->
  <div class="case-preview">
    <div class="preview-frame">
      <iframe
        src="https://www.js80.studio/turnero-preview.html"
        title="Digital appointment system"
        loading="lazy"
      ></iframe>
    </div>
  </div>

  <!-- ── Content ── -->
  <div class="case-body container">

    <div class="case-block">
      <span class="label">The challenge</span>
      <div class="case-content">
        <h2 class="serif">The bar to improve this was on the floor.</h2>
        <p>
          Booking an appointment today means five screens: raw lists with 30+ duplicate locations,
          exact-text search where a typo locks you out, and email validation only at the end of
          the flow. The result is an 18% no-show rate nobody tracks and a secretary spending the
          whole day confirming appointments one by one.
        </p>
        <ul class="case-list">
          <li>No geolocation or visible slots from the start</li>
          <li>Zero effective reminders before the appointment</li>
          <li>Cancellations that become dead schedule time</li>
          <li>Secretary types instead of attending patients</li>
        </ul>
      </div>
    </div>

    <div class="case-block">
      <span class="label">The solution</span>
      <div class="case-content">
        <h2 class="serif">Three layers. One single tool.</h2>
        <p>
          The JS80 Scheduler works in complementary layers: first the patient alone — 70% of
          appointments are booked without anyone at the practice touching a keyboard. Then
          SecretarIA for what requires natural conversation. And finally the human secretary
          with full override on everything, receiving only what the AI didn't resolve.
        </p>
        <ul class="case-list">
          <li>Patient books, confirms and reschedules without calling</li>
          <li>SecretarIA schedules via WhatsApp in natural language</li>
          <li>Waitlist covers cancellations instantly</li>
          <li>Admin panel with daily agenda and pending queue</li>
        </ul>
      </div>
    </div>

    <div class="case-block">
      <span class="label">What's included</span>
      <div class="case-chips">
        <span class="chip">Web booking</span>
        <span class="chip">WhatsApp</span>
        <span class="chip">SecretarIA</span>
        <span class="chip">Admin panel</span>
        <span class="chip">Waitlist</span>
        <span class="chip">Automatic reminders</span>
        <span class="chip">Google Calendar</span>
      </div>
    </div>

  </div>

  <!-- ── CTA ── -->
  <div class="case-cta">
    <p class="serif case-cta-title">Want something like this for your business?</p>
    <a href="mailto:contacto@juansebarrio.com?subject=Digital%20Appointment%20System%20JS80" class="btn-primary">
      Let's talk <span>→</span>
    </a>
  </div>

</LayoutJS80>

<style>
  .case-hero {
    padding: 80px 64px 72px;
    border-bottom: 0.5px solid var(--border-soft);
  }
  .case-hero-inner { max-width: 720px; }

  .case-tags {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--text-meta);
    background: var(--bg-white);
    border: 0.5px solid var(--border-line);
    border-radius: 4px;
    padding: 4px 10px;
  }

  .case-title {
    font-size: 72px;
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -2.5px;
    margin: 0 0 24px;
    color: var(--text-primary);
  }
  .case-subtitle {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 560px;
    margin: 0;
  }

  .case-preview {
    background: var(--bg-white);
    border-bottom: 0.5px solid var(--border-soft);
    padding: 48px 64px;
  }
  .preview-frame {
    max-width: 1200px;
    margin: 0 auto;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 0.5px solid var(--border-line);
    box-shadow: 0 8px 40px rgba(44, 44, 42, 0.08);
    height: 780px;
  }
  .preview-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .case-body {
    padding: 80px 64px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  .case-block {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    align-items: start;
  }

  .case-content h2 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.4px;
    margin: 0 0 16px;
    color: var(--text-primary);
  }
  .case-content p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .case-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .case-list li {
    font-size: 14px;
    color: var(--text-body);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }
  .case-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--text-ghost);
    font-size: 11px;
    top: 2px;
  }

  .case-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: flex-start;
  }
  .chip {
    font-size: 13px;
    color: var(--text-body);
    background: var(--bg-white);
    border: 0.5px solid var(--border-line);
    border-radius: var(--radius-btn);
    padding: 6px 14px;
  }

  .case-cta {
    background: var(--bg-dark);
    color: #fff;
    padding: 80px 64px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .case-cta-title {
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.6px;
    margin: 0;
    color: #fff;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    background: var(--bg-dark);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: var(--radius-btn);
    font-size: 13px;
    font-weight: 500;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(44, 44, 42, 0.3);
  }
  .btn-primary span { opacity: 0.7; transition: transform 0.2s ease; }
  .btn-primary:hover span { transform: translateX(2px); }

  @media (max-width: 900px) {
    .case-hero { padding: 56px 24px 48px; }
    .case-title { font-size: 42px; letter-spacing: -1.5px; }
    .case-preview { padding: 32px 24px; }
    .preview-frame { height: 480px; }
    .case-body { padding: 56px 24px; gap: 48px; }
    .case-block { grid-template-columns: 1fr; gap: 16px; }
    .case-cta { padding: 64px 24px; }
    .case-cta-title { font-size: 26px; }
  }
</style>
