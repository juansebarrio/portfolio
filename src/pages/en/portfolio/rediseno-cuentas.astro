    margin-top: 3rem;
  }

  /* ── LISTS ── */
  .lista-dash {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .lista-dash li {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #d0d0d0;
    display: flex;
    gap: 0.75rem;
  }

  .dash {
    color: #6b6b6b;
    flex-shrink: 0;
    font-family: 'Syne', system-ui, sans-serif;
  }

  .lista-numerada {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .lista-numerada li {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #d0d0d0;
    display: flex;
    gap: 0.75rem;
  }

  .num {
    color: #6b6b6b;
    flex-shrink: 0;
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 500;
  }

  .dash-list {
    list-style: decimal;
    padding-left: 1.5rem;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
