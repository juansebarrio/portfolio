    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    color: #a0a0a0;
    margin: -1.5rem 0 3rem;
  }

  .sub-intro {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    color: #a0a0a0;
    margin: -1.5rem 0 2rem;
  }

  .sub-titulo {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #f0f0f0;
    margin: 0 0 1.25rem;
  }

