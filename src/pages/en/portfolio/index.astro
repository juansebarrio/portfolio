---
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Portfolio — Juanse Barrio" description="Case studies by Juan Segundo Barrio: digital product design, applied AI and research.">

  <div class="page-container">

    <div class="portfolio-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 class="page-title">Case studies</h1>
    </div>

    <!-- ── NDA CASES ── -->
    <section class="nda-section">

      <!-- Locked state — visible when not auth'd -->
      <div class="nda-lock" id="nda-lock">
        <div class="lock-body">
          <div class="lock-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="lock-eyebrow">4 CASES · BANCO GALICIA · NDA</p>
          <p class="lock-desc">Product Design, AI and Research at one of Argentina's three largest banks.</p>
          <button class="lock-btn" id="unlock-btn">
            View cases
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <form id="inline-gate" class="inline-gate" style="display:none" novalidate>
            <input type="password" id="inline-input" class="inline-input" placeholder="Password" autocomplete="current-password" />
            <p id="inline-error" class="inline-error" hidden>Incorrect password. Try again.</p>
            <button type="submit" class="inline-submit">Unlock</button>
          </form>
          <p class="lock-recruiter">
            Recruiter without the password?
            <a href="mailto:contacto@juansebarrio.com?subject=Access%20to%20NDA%20case%20studies">Request access by email →</a>
          </p>
        </div>
        <div class="lock-preview" aria-hidden="true">
          <div class="preview-card preview-featured"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
        </div>
      </div>

      <!-- Unlocked cases — hidden until auth -->
      <div id="nda-content" style="display:none">
        <div class="portfolio-header-inner">
          <p class="eyebrow">NDA CASES</p>
        </div>
        <div class="casos">

          <a href="/en/portfolio/csat-semantico" class="caso-card caso-featured">
            <div class="caso-media">
              <img
                src="/images/portfolio/csat-semantico/csat-tile.webp"
                alt="Juanse presenting CSAT analysis results to a Galicia Design audience"
                loading="lazy"
                width="1600"
                height="1000" decoding="async" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · AI + Research</p>
              <h2 class="caso-titulo">Turning the voice of the customer into an actionable backlog</h2>
              <p class="caso-desc">A monthly system that classifies hundreds of CSAT comments using a proprietary AI-assisted taxonomy and delivers them as a squad-prioritized backlog.</p>
              <p class="caso-cta">View case →</p>
            </div>
          </a>

          <a href="/en/portfolio/upgrade" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/upgrade/07-video-poster.webp" alt="Final screen of the redesigned upgrade flow" loading="lazy" decoding="async" width="1384" height="720" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · Product Design</p>
              <h2 class="caso-titulo">Argentina's fastest financial system upgrade</h2>
              <p class="caso-desc">Native redesign of the package upgrade flow: from an inconsistent webview to three friction-free steps.</p>
              <p class="caso-cta">View case →</p>
            </div>
          </a>

          <a href="/en/portfolio/rediseno-cuentas" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg" alt="Cross-banca alignment workshop: team reviewing redesign screens on large monitors" loading="lazy" decoding="async" width="1920" height="1440" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2025 · Redesign</p>
              <h2 class="caso-titulo">Designing accounts from scratch</h2>
              <p class="caso-desc">Full redesign of the accounts flow, the most used feature by the bank's customers.</p>
              <p class="caso-cta">View case →</p>
            </div>
          </a>

          <a href="/en/portfolio/pfm" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/pfm/pfm-card-preview.jpg" alt="Guerrilla testing at a branch: a person using the PFM on their phone while the team takes notes" loading="lazy" decoding="async" width="1920" height="1080" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2024 · Product Design</p>
              <h2 class="caso-titulo">Argentina's first bank-built PFM</h2>
              <p class="caso-desc">Personal Finance Manager designed from research: four profiles, four ways of relating to money.</p>
              <p class="caso-cta">View case →</p>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- ── PUBLIC CASES ── -->
    <section class="casos-publicos">
      <div class="publicos-header">
        <p class="eyebrow">AI Solutions</p>
      </div>

      <div class="casos-destacados">

        <!-- Leads dashboard — featured card -->
        <a href="/en/portfolio/leads-tablero" class="caso-card">
          <div class="caso-media caso-media-leads">
            <img
              src="/images/portfolio/leads-tablero/home.webp"
              alt="Main dashboard screen with a detected pattern and leads cooling down"
              loading="eager" fetchpriority="high" decoding="async" width="1920" height="2081" />
          </div>
          <div class="caso-info">
            <p class="caso-meta">JS80 · 2026 · SaaS Product</p>
            <h2 class="caso-titulo">Leads dashboard for small businesses</h2>
            <p class="caso-desc">A lean CRM that puts one question above all others: what do I need to do today?</p>
            <p class="caso-cta">View case →</p>
          </div>
        </a>

        <!-- Impulse Bot — featured card -->
        <a href="/en/portfolio/impulse-bot" class="caso-card">
          <div class="caso-media caso-media-impulse">
            <img
              src="/images/portfolio/impulse-bot/chatbot_impulse_portada.jpeg"
              alt="Undetectable and Untransmittable — Impulse Bot's two characters"
              loading="lazy" decoding="async" width="710" height="709" />
          </div>
          <div class="caso-info">
            <p class="caso-meta">Impulse · AHF Argentina · 2025 · Conversational Design</p>
            <h2 class="caso-titulo">Impulse Bot</h2>
            <p class="caso-desc">Argentina's first chatbot fully dedicated to sexual health. 2,249 messages exchanged, 82% opt-in rate.</p>
            <p class="caso-cta">View case →</p>
          </div>
        </a>

      </div>

      <!-- JS80 — compact cards -->
      <div class="js80-sub">
        <p class="eyebrow">JS80 STUDIO</p>
      </div>
      <div class="casos-mini">

        <!-- VidrierAI — featured with priority -->
        <a href="https://www.js80.studio/vidriera" target="_blank" rel="noopener noreferrer" class="caso-mini caso-mini-priority">
          <span class="mini-badge">New</span>
          <div class="mini-media mini-media-vidriera" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 10v9.3h15V10"/><path d="M3.5 19.3h17"/><path d="M3 10l1.7-4.3A1 1 0 0 1 5.6 5h12.8a1 1 0 0 1 .9.7L21 10z"/><path d="M7.5 5.3 7 10M12 5v5M16.5 5.3 17 10"/><path d="M7.3 13h4.2v6.3H7.3z"/><path d="M16 12.2q.55 2.5 3 3-2.45.5-3 3-.55-2.5-3-3 2.45-.5 3-3Z" fill="currentColor" stroke="none"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · AI + E-commerce</p>
            <h3 class="mini-titulo">VidrierAI</h3>
            <p class="mini-desc">From a photo to a ready-to-sell listing: title, description, tags and caption for each product, generated with AI.</p>
            <p class="caso-cta">View case ↗</p>
          </div>
        </a>

        <a href="https://institucionalmultiple.js80.studio/" target="_blank" rel="noopener noreferrer" class="caso-mini">
          <div class="mini-media mini-media-turnero" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="16" height="15" rx="1.5"/><path d="M12 10v6M9 13h6"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Health</p>
            <h3 class="mini-titulo">Hospital Aranda</h3>
            <p class="mini-desc">Institutional website for a hospital, designed and shipped to production by the studio.</p>
            <p class="caso-cta">View case ↗</p>
          </div>
        </a>

        <a href="https://consulcardiologico.vercel.app/" target="_blank" rel="noopener noreferrer" class="caso-mini">
          <div class="mini-media mini-media-cardio" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Branding + Web</p>
            <h3 class="mini-titulo">Cardiología Barrio · Scarano</h3>
            <p class="mini-desc">Brand, web and AI voice agent for a cardiology practice in Bahía Blanca.</p>
            <p class="caso-cta">View case ↗</p>
          </div>
        </a>

        <a href="https://www.js80.studio/trabajo/inmobiliaria" target="_blank" rel="noopener noreferrer" class="caso-mini">
          <div class="mini-media mini-media-tablero" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="20" x2="21" y2="20"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="10"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Real Estate</p>
            <h3 class="mini-titulo">Real Estate Dashboard</h3>
            <p class="mini-desc">Real estate dashboard with sales KPIs, unit management, and real-time operational metrics.</p>
            <p class="caso-cta">View case ↗</p>
          </div>
        </a>

      </div>
    </section>

  </div>

  <script>
    const STORAGE_KEY = 'portfolio-auth';
    const PASSWORD = 'libertador123456';

    function applyAuth() {
      const lock = document.getElementById('nda-lock');
      const content = document.getElementById('nda-content');
      if (lock) lock.style.display = 'none';
      if (content) content.style.display = 'block';
    }

    if (sessionStorage.getItem(STORAGE_KEY) === 'true') applyAuth();

    const unlockBtn = document.getElementById('unlock-btn');
    const inlineGate = document.getElementById('inline-gate');
    const inlineInput = document.getElementById('inline-input');
    const inlineError = document.getElementById('inline-error');

    function showInlineForm() {
      if (unlockBtn) unlockBtn.style.display = 'none';
      if (inlineGate) inlineGate.style.display = 'flex';
      setTimeout(() => inlineInput?.focus(), 50);
    }

    unlockBtn?.addEventListener('click', showInlineForm);

    if (new URLSearchParams(window.location.search).get('unlock') === '1') {
      showInlineForm();
    }

    inlineGate?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inlineInput.value === PASSWORD) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        applyAuth();
      } else {
        inlineError.hidden = false;
        inlineInput.value = '';
        inlineInput.focus();
      }
    });
  </script>

</Layout>

<style>
  .page-container { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1.5rem, 5vw, 3rem); }

  .portfolio-header { padding: 2.5rem 0 2rem; }
  .portfolio-header-inner { padding: 0 0 1.5rem; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0.75rem 0 0;
  }

  /* ── NDA lock state ── */
  .nda-section { margin-bottom: 2rem; }

  .nda-lock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 2rem;
  }

  .lock-body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .lock-icon-wrap {
    width: 40px;
    height: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }

  .lock-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .lock-desc {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 28rem;
  }

  .lock-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.5rem;
  }

  .lock-btn:hover { background: var(--bg); color: var(--fg); transform: translateY(-1px); }

  .inline-gate {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
  }

  .lock-recruiter {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  .lock-recruiter a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .inline-input {
    padding: 0.75rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .inline-input:focus { border-color: var(--fg); }

  .inline-error {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #ff4444;
    margin: 0;
  }

  .inline-submit {
    align-self: flex-start;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .inline-submit:hover { background: var(--bg); color: var(--fg); }

  .lock-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    height: 260px;
  }

  .preview-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .preview-featured {
    grid-column: 1 / -1;
    height: auto;
  }

  /* ── Casos grid ── */
  .casos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .caso-featured {
    grid-column: 1 / -1;
    display: grid !important;
    grid-template-columns: 3fr 2fr;
    align-items: stretch;
  }

  .caso-featured .caso-media { aspect-ratio: unset; min-height: 380px; border-radius: 0; }
  .caso-featured .caso-info { padding: 2.5rem; justify-content: center; gap: 0; }
  .caso-featured .caso-titulo { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-top: 1rem; }
  .caso-featured .caso-desc { margin-top: 1rem; font-size: 1rem; }
  .caso-featured .caso-cta { margin-top: 2rem; align-self: flex-start; }

  .caso-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
  }

  .caso-card:hover { transform: translateY(-4px); background: var(--surface); }

  .caso-media {
    aspect-ratio: 16 / 10;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-media video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .caso-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .caso-info { padding: 1.75rem; display: flex; flex-direction: column; }

  .caso-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .caso-titulo {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.2;
    margin: 0.75rem 0 0;
  }

  .caso-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .caso-cta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 1.25rem 0 0;
    align-self: flex-end;
    transition: color 0.2s ease;
  }

  .caso-card:hover .caso-cta { color: var(--fg); }

  /* ── Públicos ── */
  .casos-publicos {
    padding-top: 3.5rem;
    border-top: 1px solid var(--hairline);
    padding-bottom: 8rem;
  }

  .publicos-header { margin-bottom: 1.5rem; }

  /* ── Cards destacadas: 2 columnas en desktop ── */
  .casos-destacados {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* Aspect ratios iguales para que ambas cards queden a la misma altura.
     16/9 + padding del info da un total más compacto. */
  .caso-media-impulse { background: #1a0f07; aspect-ratio: 16 / 9; }
  .caso-media-impulse img { object-position: center 12%; }

  .caso-media-leads { background: var(--surface); aspect-ratio: 16 / 9; }
  .caso-media-leads img { object-fit: cover; object-position: center top; }

  .casos-destacados .caso-info { padding: 1.5rem; }
  .casos-destacados .caso-titulo { font-size: 1.125rem; margin-top: 0.5rem; }
  .casos-destacados .caso-desc { font-size: 0.9375rem; margin-top: 0.5rem; }
  .casos-destacados .caso-cta { margin-top: 1rem; }

  @media (max-width: 900px) {
    .casos-destacados { grid-template-columns: 1fr; }
  }

  /* JS80 subsection */
  .js80-sub { margin-top: 2.5rem; margin-bottom: 1rem; }

  .casos-mini { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

  .caso-mini {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .caso-mini:hover { transform: translateY(-3px); background: var(--surface); }
  .caso-mini:hover .caso-cta { color: var(--fg); }

  /* VidrierAI — featured with priority */
  .caso-mini-priority {
    border-color: color-mix(in oklab, #7158d6 45%, var(--border));
    box-shadow: 0 0 0 1px color-mix(in oklab, #7158d6 28%, transparent),
                0 8px 24px color-mix(in oklab, #7158d6 12%, transparent);
  }

  .caso-mini-priority:hover {
    box-shadow: 0 0 0 1px color-mix(in oklab, #7158d6 45%, transparent),
                0 12px 30px color-mix(in oklab, #7158d6 18%, transparent);
  }

  .mini-badge {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: #7158d6;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    line-height: 1;
  }

  .mini-media {
    height: 96px;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mini-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Brand tints — color del producto sobre surface del theme.
     En light: tinta pastel. En dark: tinta profunda. */
  .mini-media-turnero { background: color-mix(in oklab, #4a7fa8 14%, var(--surface)); color: #4a7fa8; }

  .mini-media-cardio  { background: color-mix(in oklab, #8a4450 14%, var(--surface)); color: #8a4450; }

