<style is:global>
  .acc-bullets { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
  .acc-bullets li { padding-left: 1.5rem; position: relative; color: var(--fg); font-size: 0.875rem; line-height: 1.75; }
  .acc-bullets li::before { content: '—'; position: absolute; left: 0; color: var(--muted); }
  .acc-desc { color: var(--muted); font-size: 0.875rem; line-height: 1.75; margin-bottom: 1.25rem; }
  .acc-ia-block .acc-desc { margin-bottom: 0.75rem; }
  .acc-ia-block { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .acc-ia-label { font-size: 0.625rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.85rem; }
  .skills-group { margin-bottom: 1.5rem; }
  .skills-group:last-child { margin-bottom: 0; }
  .skills-group-label { font-size: 0.625rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.4rem; }
  .skills-list { color: var(--fg); font-size: 0.875rem; line-height: 1.8; }
</style>

<style>
  .exp-header { padding: 5rem 5rem 3.5rem; border-bottom: 1px solid var(--hairline); }
  .exp-title { font-family: var(--font-sans) !important; font-size: clamp(3rem, 7vw, 6rem) !important; font-weight: 700; letter-spacing: -0.03em; color: var(--fg); margin: 0 0 1.25rem; line-height: 1; }
  .exp-subtitle { color: var(--muted); font-size: 1rem; max-width: 52ch; line-height: 1.7; margin: 0; }

  .exp-columns { display: grid; grid-template-columns: 1fr 1fr; padding: 0 5rem; }
  .exp-col { padding: 3rem 2rem 3rem 0; }
  .exp-col + .exp-col { padding: 3rem 0 3rem 4rem; border-left: 1px solid var(--hairline); }
  .exp-col-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
  .exp-col-heading { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0; }

  .expand-toggle { font-size: 0.875rem; font-weight: 400; font-family: var(--font-sans); color: var(--muted); background: none; border: none; cursor: pointer; padding: 0; line-height: 1; transition: color 0.2s ease; letter-spacing: 0; text-transform: none; }
  .expand-toggle:hover { color: var(--fg); }

  .col-cta { display: inline-flex; align-items: center; margin-top: 2rem; padding: 0.7rem 1.5rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.04em; color: var(--fg); background-color: var(--surface); border: 1px solid var(--border); text-decoration: none; transition: border-color 0.2s ease; }
  .col-cta:hover { border-color: var(--fg); }

  .exp-section { padding: 0 5rem; border-top: 1px solid var(--hairline); }
  .exp-section--last { margin-bottom: 5rem; }
  .exp-section-heading { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); padding: 2.5rem 0 0.5rem; margin: 0; }

  .cert-section { padding-bottom: 0; }
  .cert-block { padding-top: 2rem; }
  .cert-block--badges { margin-top: 4rem; }
  .cert-block--list { margin-top: 4rem; }
  .cert-block-subtitle { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin: 0 0 1.25rem; }

  .carousel-outer { position: relative; }
  .carousel-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; gap: 1rem; scrollbar-width: none; -ms-overflow-style: none; }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-item { flex-shrink: 0; scroll-snap-align: start; }
  .carousel-track--certs .carousel-item { flex: 0 0 calc((100% - 4 * 1rem) / 5); }
  .carousel-track--certs .carousel-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .carousel-track--badges .carousel-item { flex: 0 0 calc((100% - 4 * 1rem) / 5); }
  .carousel-track--badges .carousel-item img { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; display: block; background: var(--surface); padding: 1.25rem; }

  .carousel-btn { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); color: var(--fg); font-size: 1.25rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10; transition: border-color 0.2s ease; }
  .carousel-btn:hover { border-color: var(--fg); }
  .carousel-btn[hidden] { display: none !important; }
  .carousel-btn--prev { left: -22px; }
  .carousel-btn--next { right: -22px; }

  .cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem 2rem; padding-top: 0.5rem; }
  .cert-item { display: flex; align-items: center; gap: 1rem; padding: 0.375rem 0; }
  .cert-logo-wrap { width: 40px; height: 40px; min-width: 40px; border-radius: 8px; background: var(--surface); padding: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .cert-logo-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .cert-logo-empty { width: 40px; height: 40px; min-width: 40px; }
  .cert-info { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .cert-name { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 500; color: var(--fg); margin: 0; line-height: 1.3; }
  .cert-institution { font-size: 0.8125rem; color: var(--muted); margin: 0; line-height: 1.3; }

  @media (max-width: 1024px) {
    .carousel-track--certs .carousel-item { flex: 0 0 calc((100% - 1rem) / 2); }
    .carousel-track--badges .carousel-item { flex: 0 0 calc((100% - 2 * 1rem) / 3); }
  }

  @media (max-width: 768px) {
    .exp-header { padding: 3rem 1.5rem 2.5rem; }
    .exp-columns { grid-template-columns: 1fr; padding: 0 1.5rem; }
    .exp-col { padding: 3rem 0; min-width: 0; }
    .exp-col + .exp-col { padding: 3rem 0; border-left: none; border-top: 1px solid var(--hairline); }
    .exp-section { padding: 0 1.5rem; }
    .carousel-track--certs .carousel-item { flex: 0 0 100%; }
    .carousel-track--badges .carousel-item { flex: 0 0 calc((100% - 1rem) / 2); }
    .carousel-btn { display: none !important; }
    .cert-grid { grid-template-columns: 1fr; }
    .exp-cta-banner { padding: 4rem 1.5rem 5rem; }
  }

  /* ── CTA BANNER (closing) ── */
  .exp-cta-banner { padding: 6rem 5rem 7rem; border-top: 1px solid var(--hairline); text-align: center; }
  .exp-cta-inner { max-width: 32rem; margin: 0 auto; }
  .cta-banner-eyebrow { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin: 0 0 1.25rem; }
  .cta-banner-heading { font-family: var(--font-sans); font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; color: var(--fg); margin: 0 0 1rem; line-height: 1.1; }
  .cta-banner-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 2.25rem; }
  .cta-banner-link { display: inline-flex; align-items: center; padding: 0.9rem 1.85rem; font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.02em; color: var(--bg); background-color: var(--fg); border: 1px solid var(--fg); border-radius: 8px; text-decoration: none; transition: background-color 0.2s ease, transform 0.2s ease; }
  .cta-banner-link:hover { background-color: var(--bg); color: var(--fg); transform: translateY(-1px); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.exp-col').forEach((col) => {
    const btn = col.querySelector<HTMLButtonElement>('.expand-toggle');
    if (!btn) return;

    const getDetails = () => col.querySelectorAll<HTMLDetailsElement>('details');

    const syncLabel = () => {
      const all = getDetails();
      const allOpen = [...all].every((d) => d.open);
      btn.textContent = allOpen ? 'Collapse all ↑' : 'Expand all ↓';
    };

    btn.addEventListener('click', () => {
      const all = getDetails();
      const allOpen = [...all].every((d) => d.open);
      all.forEach((d) => { d.open = !allOpen; });
      syncLabel();
    });

    getDetails().forEach((d) => d.addEventListener('toggle', syncLabel));
    syncLabel();
  });
</script>

<script>
  function initCarousel(outer: HTMLElement) {
    const track = outer.querySelector<HTMLElement>('.carousel-track');
    const prev = outer.querySelector<HTMLButtonElement>('.carousel-btn--prev');
    const next = outer.querySelector<HTMLButtonElement>('.carousel-btn--next');
    if (!track || !prev || !next) return;

    const step = (): number => {
      const item = track.querySelector<HTMLElement>('.carousel-item');
      if (!item) return 200;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
      return item.offsetWidth + gap;
    };

    const sync = () => {
      prev.hidden = track.scrollLeft <= 1;
      next.hidden = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  }

  document.querySelectorAll<HTMLElement>('.carousel-outer').forEach(initCarousel);
</script>
