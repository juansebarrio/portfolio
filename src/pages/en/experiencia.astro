---
import Layout from '../../layouts/Layout.astro';
import Accordion from '../../components/Accordion.astro';
import VoiceSection from '../../components/VoiceSection.astro';
---

<Layout
  title="Experience — Juanse Barrio"
  description="Nine years designing digital products, leading teams, and teaching at university."
>

  <header class="exp-header">
    <h1 class="exp-title">Experience</h1>
    <p class="exp-subtitle">
      Nine years designing digital products, leading teams, and teaching at university.
      Focused on research, applied AI, and measurable results.
    </p>
  </header>

  <VoiceSection
    sectionId="juan-ia"
    agentId="agent_0801kqf4rva9ezttcab527sp0cbm"
    eyebrow="Juanse AI"
    heading="Ask me anything."
    sub="An agent trained on my experience that answers as if it were me: projects, product decisions, teams, and how I work."
    idle="Tap to talk"
    connecting="Connecting…"
    listening="Listening…"
    speaking="Answering…"
    error="Something went wrong. Try again."
    end="End conversation"
    compact={true}
    ctaLabel="Book a meeting →"
    ctaHref="https://calendar.app.google/ZCQuzHpjeGnoKUrp6"
  />

  <div class="exp-columns">

    <!-- LEFT: ROLES -->
    <div class="exp-col" id="col-roles">
      <div class="exp-col-header">
        <p class="exp-col-heading">Roles</p>
        <button class="expand-toggle" type="button">Expand all</button>
      </div>

      <Accordion title="Product Designer — Banco Galicia" meta="Aug 2022 – May 2026">
        <p class="acc-desc">
          Digital product design in multidisciplinary squads for Everyday Banking. Units: Accounts,
          Packages, Upgrades & Transactions (GMB) and Bill Payments & Top-ups (GMS). Previously: Lending team.
        </p>
        <ul class="acc-bullets">
          <li>Qualitative and quantitative research (interviews, mass feedback analysis, asynchronous tests) and experiments to validate solutions before building them.</li>
          <li>Design and launch of the bank's first PFM, later expanded to other teams.</li>
          <li>End-to-end experience for HSBC customers during the acquisition: product mapping, package deduplication, cancellation flows and incentive mechanics.</li>
          <li>Full redesign of the Accounts section, one of the highest-traffic areas of the app.</li>
          <li>Research on banking trends and BCRA/CNV regulations for the underage segment.</li>
          <li>Usage and contribution to the design system with new patterns.</li>
        </ul>
        <div class="acc-ia-block">
          <p class="acc-ia-label">AI Projects</p>
          <ul class="acc-bullets">
            <li>AI-assisted semantic CSAT analysis: a proprietary system to convert feedback into actionable insights and a prioritized backlog. Foundation for a new Digital Vision squad.</li>
            <li>Claude Code to map and document complex product flows.</li>
            <li>GA4 to validate funnels and detect friction before designing.</li>
            <li>Figma Make for AI-assisted prototyping in early stages.</li>
          </ul>
        </div>
      </Accordion>

      <Accordion title="Vice President — Impulse Buenos Aires (AHF)" meta="Sep 2025 – Present">
        <p class="acc-desc">
          Impulse is the Argentine chapter of AHF, the world's leading HIV prevention organization,
          present in more than 45 countries.
        </p>
        <ul class="acc-bullets">
          <li>Coordination of chapter projects: events, communications, operations, and institutional relations.</li>
          <li>Management of 7 area leads and ~40 active volunteers.</li>
          <li>Definition and control of the annual budget with due diligence.</li>
          <li>Partnerships with organizations and companies with CSR programs, including sponsorships.</li>
          <li>Coordination with AHF's global network, aligning local strategy.</li>
          <li>Volunteer retention plan and new alliances with the private sector.</li>
        </ul>
        <div class="acc-ia-block">
          <p class="acc-ia-label">AI Projects</p>
          <ul class="acc-bullets">
            <li>Claude Cowork to automate internal processes and coordinate flows between areas.</li>
          </ul>
        </div>
      </Accordion>

      <Accordion title="Operations Lead — Impulse Buenos Aires (AHF)" meta="Sep 2023 – Sep 2025">
        <p class="acc-desc">
          Design and implementation of the chapter's operating system.
        </p>
        <ul class="acc-bullets">
          <li>Project tracking and coordination system built from scratch.</li>
          <li>Complete reconstruction of financial transparency processes; recognized by other AHF chapters globally.</li>
          <li>Supplier database and due diligence processes.</li>
          <li>Notion operating system as the central hub, integrated with other platforms.</li>
          <li>Budget management and monthly reports with the accounting firm and executive partners.</li>
        </ul>
        <div class="acc-ia-block">
          <p class="acc-ia-label">AI Projects</p>
          <ul class="acc-bullets">
            <li>Full end-to-end campaigns using generative AI: video (Kling), audio and music (Suno), voiceover (Eleven Labs), graphic assets.</li>
            <li>Claude Code to build internal management applications without external development resources.</li>
            <li>AI for automated completion and verification of sensitive documents.</li>
          </ul>
        </div>
      </Accordion>

      <Accordion title="Adjunct Professor — Universidad de San Andrés (UdeSA)" meta="Aug 2023 – Dec 2024">
        <p class="acc-desc">
          UX Design for the Bachelor's in Digital Business, 3rd year.
        </p>
        <ul class="acc-bullets">
          <li>Teaching the course combining theory and real industry cases.</li>
          <li>Mentorship and project evaluation for 20 to 30 students per cohort.</li>
          <li>Contribution to the creation and iteration of the syllabus.</li>
          <li>Incorporation of content on the future of digital products, AI, and ecosystem trends.</li>
        </ul>
      </Accordion>

      <Accordion title="UX Designer — PricewaterhouseCoopers (PwC)" meta="May 2021 – Aug 2022">
        <p class="acc-desc">
          Acceleration Center Buenos Aires · Business Excellence · Internal Firm Services.
        </p>
        <ul class="acc-bullets">
          <li>Internal UX consultant: identifying improvement opportunities through KPIs and manager interviews.</li>
          <li>End-to-end design of the corporate employee management chatbot (vacation, space booking, feedback).</li>
          <li>Multidisciplinary team of 10 people reporting directly to the Acceleration Center's Partner and COO.</li>
          <li>Promoting a UX mindset through internal events, talks, and workshops.</li>
        </ul>
      </Accordion>
    </div>

    <!-- RIGHT: ACHIEVEMENTS -->
    <div class="exp-col" id="col-logros">
      <div class="exp-col-header">
        <p class="exp-col-heading">Key achievements</p>
        <button class="expand-toggle" type="button">Expand all</button>
      </div>

      <Accordion title="AI-powered semantic CSAT analysis — Banco Galicia">
        <p class="acc-desc">
          I designed and led the development of a proprietary AI-assisted semantic analysis system
          to process customer feedback at scale, convert it into actionable insights linked
          to CSAT, and generate a bank-wide prioritized backlog. The project changed how the organization
          connects design decisions with customer outcomes and served as the foundation for a new Digital Vision squad.
        </p>
      </Accordion>

      <Accordion title="HSBC Integration — Banco Galicia">
        <p class="acc-desc">
          Design of critical flows for migrating HSBC customers to the Galicia ecosystem during
          the acquisition: product mapping, package deduplication management, new cancellation flows, and
          incentive mechanics to consolidate products.
        </p>
      </Accordion>

      <Accordion title="Bank's first PFM — Banco Galicia">
        <p class="acc-desc">
          Led the design and launch of the bank's first Personal Finance Management tool.
          The product was later expanded to other teams and products on the platform.
        </p>
      </Accordion>

      <Accordion title="Accounts Redesign — Banco Galicia">
        <p class="acc-desc">
          Full renovation of one of the oldest and highest-traffic sections of the app,
          focused on usability, scalability, and technical robustness.
        </p>
      </Accordion>

      <Accordion title="Generative AI campaigns — Impulse (AHF)">
        <p class="acc-desc">
          Design and production of complete campaigns using end-to-end generative AI: video (Kling),
          music (Suno), voiceover (Eleven Labs), and graphic assets. High-quality pieces produced
          in a fraction of the usual time and cost.
        </p>
      </Accordion>

      <Accordion title="Regional Summit 2024 — Impulse (AHF)">
        <p class="acc-desc">
          Co-led the end-to-end organization of a summit with 50+ guests from 6 countries and
          cultural events with 30+ local artists.
        </p>
      </Accordion>

      <Accordion title="Financial transparency — Impulse (AHF)">
        <p class="acc-desc">
          Rebuilt the financial management system from scratch.
          Formally recognized by other AHF chapters globally.
        </p>
      </Accordion>

      <Accordion title="Corporate chatbot — PwC">
        <p class="acc-desc">
          End-to-end design of the employee management chatbot, integrating vacation flows,
          space booking, feedback requests, and more.
        </p>
      </Accordion>

      <a href="/en/portfolio" class="col-cta">View case studies →</a>
    </div>

  </div>

  <!-- ── EDUCATION ── -->
  <section class="exp-section">
    <p class="exp-section-heading">Education</p>
    <Accordion title="UADE — Graphic, Multimedia & Interaction Design" meta="Buenos Aires">
      <p class="acc-desc">
        GPA 8.75 / 10.
      </p>
    </Accordion>
  </section>

  <!-- ── SKILLS ── -->
  <section class="exp-section">
    <p class="exp-section-heading">Skills</p>
    <Accordion title="View all skills">
      <div class="skills-group">
        <p class="skills-group-label">Design & Product</p>
        <p class="skills-list">Figma (Advanced) · Figma Make (Advanced) · Hotjar (Advanced) · Miro (Advanced)</p>
      </div>
      <div class="skills-group">
        <p class="skills-group-label">Data & Analytics</p>
        <p class="skills-list">SQL (Intermediate) · Power BI (Intermediate) · GA4 (Intermediate) · Excel (Intermediate)</p>
      </div>
      <div class="skills-group">
        <p class="skills-group-label">AI & Emerging tools</p>
        <p class="skills-list">Claude Code · Claude Cowork · Kling · Suno · Eleven Labs</p>
      </div>
      <div class="skills-group">
        <p class="skills-group-label">Other</p>
        <p class="skills-list">Microsoft Teams Webinar (Advanced) · ServiceNow (Intermediate) · HTML5 (Basic) · CSS (Basic)</p>
      </div>
      <div class="skills-group">
        <p class="skills-group-label">Languages</p>
        <p class="skills-list">Spanish (Native) · English (C1)</p>
      </div>
    </Accordion>
  </section>

  <!-- ── TRAINING & CERTIFICATIONS ── -->
  <section class="exp-section cert-section">
    <p class="exp-section-heading">Training & Certifications</p>

    <div class="cert-block">
      <p class="cert-block-subtitle">Certificates</p>
      <div class="carousel-outer">
        <button class="carousel-btn carousel-btn--prev" aria-label="Previous">&#x2039;</button>
        <div class="carousel-track carousel-track--certs">
