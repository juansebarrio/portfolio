---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Portfolio — Juanse Barrio" description="Casos de estudio de Juan Segundo Barrio: diseño de productos digitales, IA aplicada y research.">

  <div class="page-container">

    <div class="portfolio-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 class="page-title">Casos de estudio</h1>
    </div>

    <!-- ── CASOS NDA ── -->
    <section class="nda-section">

      <!-- Estado cerrado — visible si no está auth'd -->
      <div class="nda-lock" id="nda-lock">
        <div class="lock-body">
          <div class="lock-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="lock-eyebrow">4 CASOS · BANCO GALICIA · NDA</p>
          <p class="lock-desc">Product Design, IA y Research en la app de uno de los tres bancos más grandes de Argentina.</p>
          <button class="lock-btn" id="unlock-btn">
            Ver los casos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <form id="inline-gate" class="inline-gate" style="display:none" novalidate>
            <input type="password" id="inline-input" class="inline-input" placeholder="Contraseña" autocomplete="current-password" />
            <p id="inline-error" class="inline-error" hidden>Contraseña incorrecta</p>
            <button type="submit" class="inline-submit">Acceder</button>
          </form>
        </div>
        <div class="lock-preview" aria-hidden="true">
          <div class="preview-card preview-featured"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
        </div>
      </div>

      <!-- Casos desbloqueados — ocultos hasta auth -->
      <div id="nda-content" style="display:none">
        <div class="portfolio-header-inner">
          <p class="eyebrow">CASOS BAJO NDA</p>
        </div>
        <div class="casos">

          <a href="/portfolio/csat-semantico" class="caso-card caso-featured">
            <div class="caso-media">
              <img
                src="/images/portfolio/csat-semantico/csat-tile.webp"
                alt="Juanse presentando los resultados del análisis CSAT a una audiencia de Galicia Design"
                loading="eager" fetchpriority="high"
                width="1600"
                height="1000" decoding="async" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · IA + Research</p>
              <h2 class="caso-titulo">Convertir la voz del cliente en un backlog accionable</h2>
              <p class="caso-desc">Sistema mensual que clasifica cientos de comentarios de CSAT con una taxonomía propia asistida por IA y los entrega como backlog priorizado por squad.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/upgrade" class="caso-card">
            <div class="caso-media">
              <video src="/images/portfolio/upgrade/07-video-final.mov" autoplay muted loop playsinline></video>
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · Product Design</p>
              <h2 class="caso-titulo">El upgrade más rápido del sistema financiero argentino</h2>
              <p class="caso-desc">Rediseño nativo del flujo de upgrade de paquetes: de una webview inconsistente a tres pasos sin fricción.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/rediseno-cuentas" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg" alt="Taller de alineación entre bancas: equipo revisando pantallas del rediseño en monitores grandes" loading="lazy" decoding="async" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2025 · Rediseño</p>
              <h2 class="caso-titulo">Diseñando cuentas desde cero</h2>
              <p class="caso-desc">Rediseño completo del flujo de cuentas, la funcionalidad más usada por los clientes del banco.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/pfm" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/pfm/pfm-card-preview.jpg" alt="Testeo guerrilla en sucursal: una persona usando el PFM en el celular mientras el equipo toma notas" loading="lazy" decoding="async" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2024 · Product Design</p>
              <h2 class="caso-titulo">El primer PFM argentino hecho por un banco</h2>
              <p class="caso-desc">Personal Finance Manager diseñado desde research: cuatro perfiles, cuatro formas de relacionarse con la plata.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- ── PROYECTOS PÚBLICOS ── -->
    <section class="casos-publicos">
      <div class="publicos-header">
        <p class="eyebrow">PROYECTOS PÚBLICOS</p>
      </div>

      <!-- Tablero de leads — card completa -->
      <a href="/portfolio/leads-tablero" class="caso-card">
        <div class="caso-media caso-media-leads">
          <img
            src="/images/portfolio/leads-tablero/home.png"
            alt="Pantalla del tablero principal con patrón detectado y leads que se enfrían"
            loading="lazy" decoding="async" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">JS80 · 2026 · Producto SaaS</p>
          <h2 class="caso-titulo">Tablero de leads para PyMEs</h2>
          <p class="caso-desc">Un CRM ligero que prioriza una pregunta sobre todas las demás: ¿qué tengo que hacer hoy? Detección de patrones, kanban del pipeline y demo pública sin login.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Impulse Bot — card completa -->
      <a href="/portfolio/impulse-bot" class="caso-card">
        <div class="caso-media caso-media-impulse">
          <img
            src="/images/portfolio/impulse-bot/chatbot_impulse_portada.jpeg"
            alt="Indetectable e Intransmisible — los dos personajes del Impulse Bot"
            loading="lazy" decoding="async" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Impulse · AHF Argentina · 2025 · Conversational Design</p>
          <h2 class="caso-titulo">Impulse Bot</h2>
          <p class="caso-desc">El primer chatbot de Argentina dedicado 100% a salud sexual. 2,249 mensajes intercambiados, 82% de opt-in, dos olas de activación en el calendario LGBTIQ+.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- JS80 — cards compactas -->
      <div class="js80-sub">
        <p class="eyebrow">JS80 STUDIO</p>
      </div>
      <div class="casos-mini">

        <a href="/js80/turnero-digital" class="caso-mini">
          <div class="mini-media mini-media-turnero" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><rect x="8" y="14" width="3" height="3" rx="0.5"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Product Design</p>
            <h3 class="mini-titulo">Turnero Digital</h3>
            <p class="mini-desc">Sistema de turnos web + WhatsApp + IA para consultorios. 70% de reservas sin secretaria.</p>
            <p class="caso-cta">Ver caso →</p>
          </div>
        </a>

        <a href="/js80/cardiologia-barrio-scarano" class="caso-mini">
          <div class="mini-media mini-media-cardio" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Branding + Web</p>
            <h3 class="mini-titulo">Cardiología Barrio · Scarano</h3>
            <p class="mini-desc">Marca, web y agente de voz con IA para un consultorio cardiológico en Bahía Blanca.</p>
            <p class="caso-cta">Ver caso →</p>
          </div>
        </a>

        <a href="https://www.js80.studio/trabajo/inmobiliaria" target="_blank" rel="noopener noreferrer" class="caso-mini">
          <div class="mini-media mini-media-tablero" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="20" x2="21" y2="20"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="10"/></svg>
          </div>
          <div class="mini-info">
            <p class="caso-meta">JS80 · 2026 · Real Estate</p>
            <h3 class="mini-titulo">Tablero de Ventas</h3>
            <p class="mini-desc">Dashboard inmobiliario con KPIs de ventas, gestión de unidades y métricas operativas en tiempo real.</p>
            <p class="caso-cta">Ver caso ↗</p>
          </div>
        </a>

      </div>
    </section>

  </div>

  <script>
    const STORAGE_KEY = 'portfolio-auth';
    const PASSWORD = 'libertador123456';

    function applyAuth() {
      const lock = document.getElementById('nda-lock');
      const content = document.getElementById('nda-content');
      if (lock) lock.style.display = 'none';
      if (content) content.style.display = 'block';
    }

    if (sessionStorage.getItem(STORAGE_KEY) === 'true') applyAuth();

    const unlockBtn = document.getElementById('unlock-btn');
    const inlineGate = document.getElementById('inline-gate');
    const inlineInput = document.getElementById('inline-input');
    const inlineError = document.getElementById('inline-error');

    function showInlineForm() {
      if (unlockBtn) unlockBtn.style.display = 'none';
      if (inlineGate) inlineGate.style.display = 'flex';
      setTimeout(() => inlineInput?.focus(), 50);
    }

    unlockBtn?.addEventListener('click', showInlineForm);

    if (new URLSearchParams(window.location.search).get('unlock') === '1') {
      showInlineForm();
    }

    inlineGate?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inlineInput.value === PASSWORD) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        applyAuth();
      } else {
        inlineError.hidden = false;
        inlineInput.value = '';
        inlineInput.focus();
      }
    });
  </script>

</Layout>

<style>
  .page-container { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1.5rem, 5vw, 3rem); }

  .portfolio-header { padding: 2.5rem 0 2rem; }
  .portfolio-header-inner { padding: 0 0 1.5rem; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0.75rem 0 0;
  }

  /* ── NDA lock state ── */
  .nda-section { margin-bottom: 2rem; }

  .nda-lock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 2rem;
  }

  .lock-body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .lock-icon-wrap {
    width: 40px;
    height: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }

  .lock-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .lock-desc {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 28rem;
  }

  .lock-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.5rem;
  }

  .lock-btn:hover { background: var(--bg); color: var(--fg); transform: translateY(-1px); }

  .inline-gate {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
  }

  .inline-input {
    padding: 0.75rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .inline-input:focus { border-color: var(--fg); }

  .inline-error {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #ff4444;
    margin: 0;
  }

  .inline-submit {
    align-self: flex-start;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .inline-submit:hover { background: var(--bg); color: var(--fg); }

  /* Preview grid of ghost cards */
  .lock-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    height: 260px;
  }

  .preview-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .preview-featured {
    grid-column: 1 / -1;
    height: auto;
  }

  /* ── Casos grid ── */
  .casos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .caso-featured {
    grid-column: 1 / -1;
    display: grid !important;
    grid-template-columns: 3fr 2fr;
    align-items: stretch;
  }

  .caso-featured .caso-media { aspect-ratio: unset; min-height: 380px; border-radius: 0; }
  .caso-featured .caso-info { padding: 2.5rem; justify-content: center; gap: 0; }
  .caso-featured .caso-titulo { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-top: 1rem; }
  .caso-featured .caso-desc { margin-top: 1rem; font-size: 1rem; }
  .caso-featured .caso-cta { margin-top: 2rem; align-self: flex-start; }

  .caso-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
  }

  .caso-card:hover { transform: translateY(-4px); background: var(--surface); }

  .caso-media {
    aspect-ratio: 16 / 10;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-media video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .caso-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .caso-info { padding: 1.75rem; display: flex; flex-direction: column; }

  .caso-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .caso-titulo {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.2;
    margin: 0.75rem 0 0;
  }

  .caso-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .caso-cta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 1.25rem 0 0;
    align-self: flex-end;
    transition: color 0.2s ease;
  }

  .caso-card:hover .caso-cta { color: var(--fg); }

  /* ── Públicos ── */
  .casos-publicos {
    padding-top: 3.5rem;
    border-top: 1px solid var(--hairline);
    padding-bottom: 8rem;
  }

  .publicos-header { margin-bottom: 1.5rem; }

  .caso-media-impulse { background: #1a0f07; aspect-ratio: 16 / 6; }
  .caso-media-impulse img { object-position: center 12%; }

  .caso-media-leads { background: var(--surface); aspect-ratio: 16 / 9; }
  .caso-media-leads img { object-fit: cover; object-position: center top; }

  .casos-publicos > .caso-card + .caso-card { margin-top: 1.5rem; }

  /* JS80 subsección */
  .js80-sub {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* Mini cards JS80 — grid 3 col horizontal */
  .casos-mini {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .caso-mini {
    display: grid;
    grid-template-columns: 100px 1fr;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
    min-height: 100px;
  }

  .caso-mini:hover { transform: translateY(-3px); background: var(--surface); }
  .caso-mini:hover .caso-cta { color: var(--fg); }

  .mini-media {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mini-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Brand tints — color del producto sobre surface del theme.
     En light: tinta pastel. En dark: tinta profunda. */
  .mini-media-turnero {
    background: color-mix(in oklab, #4a7fa8 14%, var(--surface));
    color: #4a7fa8;
  }

  .mini-media-cardio {
    background: color-mix(in oklab, #8a4450 14%, var(--surface));
    color: #8a4450;
  }

  .mini-media-tablero {
    background: color-mix(in oklab, #4a8a7a 14%, var(--surface));
    color: #4a8a7a;
  }

  .mini-info {
    padding: 1.125rem 1.125rem 1.125rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .mini-titulo {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.2;
    margin: 0.5rem 0 0;
  }

  .mini-desc {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0.5rem 0 0;
    flex: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nda-lock { grid-template-columns: 1fr; }
    .lock-preview { display: none; }
    .casos { grid-template-columns: 1fr 1fr; }
    .caso-featured { grid-column: 1 / -1; grid-template-columns: 1fr; }
    .caso-featured .caso-media { aspect-ratio: 16 / 9; min-height: unset; }
  }

  @media (max-width: 600px) {
    .nda-lock { padding: 2rem; }
    .casos { grid-template-columns: 1fr; }
    .caso-featured { grid-template-columns: 1fr; }
    .casos-mini { grid-template-columns: 1fr; }
  }
</style>
