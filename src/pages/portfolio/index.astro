---
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';

export const prerender = false;
---

<Layout title="Portfolio — Juanse Barrio" description="Casos de estudio de Juan Segundo Barrio: diseño, IA y research en productos digitales de Banco Galicia.">

  <PasswordGate autoShow={true} />

  <div id="portfolio-content" style="display:none">
  <div class="page-container">

    <!-- ── HEADER ── -->
    <div class="portfolio-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 class="page-title">Casos de estudio</h1>
    </div>

    <!-- ── GRILLA DE CASOS ── -->
    <section class="casos">

      <!-- Caso 1: CSAT semántico — FEATURED -->
      <a href="/portfolio/csat-semantico" class="caso-card caso-featured">
        <div class="caso-media">
          <img
            src="/images/portfolio/csat-semantico/csat-tile.webp"
            alt="Juanse presentando los resultados del análisis CSAT a una audiencia de Galicia Design"
            loading="eager"
            width="1600"
            height="1000"
          />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2026 · IA + Research</p>
          <h2 class="caso-titulo">Convertir la voz del cliente en un backlog accionable</h2>
          <p class="caso-desc">Sistema mensual que clasifica cientos de comentarios de CSAT con una taxonomía propia asistida por IA y los entrega como backlog priorizado por squad.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 2: Upgrade -->
      <a href="/portfolio/upgrade" class="caso-card">
        <div class="caso-media">
          <video
            src="/images/portfolio/upgrade/07-video-final.mov"
            autoplay
            muted
            loop
            playsinline
          ></video>
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2026 · Product Design</p>
          <h2 class="caso-titulo">El upgrade más rápido del sistema financiero argentino</h2>
          <p class="caso-desc">Rediseño nativo del flujo de upgrade de paquetes: de una webview inconsistente a tres pasos sin fricción.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 3: Rediseño cuentas -->
      <a href="/portfolio/rediseno-cuentas" class="caso-card">
        <div class="caso-media">
          <img src="/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg" alt="Taller de alineación entre bancas: equipo revisando pantallas del rediseño en monitores grandes" loading="lazy" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2025 · Rediseño</p>
          <h2 class="caso-titulo">Diseñando cuentas desde cero</h2>
          <p class="caso-desc">Rediseño completo del flujo de cuentas, la funcionalidad más usada por los clientes del banco.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 4: PFM -->
      <a href="/portfolio/pfm" class="caso-card">
        <div class="caso-media">
          <img src="/images/portfolio/pfm/pfm-card-preview.jpg" alt="Testeo guerrilla en sucursal: una persona usando el PFM en el celular mientras el equipo toma notas" loading="lazy" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2024 · Product Design</p>
          <h2 class="caso-titulo">El primer PFM argentino hecho por un banco</h2>
          <p class="caso-desc">Personal Finance Manager diseñado desde research: cuatro perfiles, cuatro formas de relacionarse con la plata.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

    </section>

  </div>
  </div>

  <!-- ── CASOS PÚBLICOS (sin gate) ── -->
  <div class="page-container">
    <section class="casos casos-publicos">

      <div class="publicos-header">
        <p class="eyebrow">PROYECTO PÚBLICO</p>
      </div>

      <a href="/portfolio/impulse-bot" class="caso-card">
        <div class="caso-media caso-media-impulse">
          <div class="impulse-visual" aria-hidden="true">
            <span class="impulse-wm">💬</span>
          </div>
        </div>
        <div class="caso-info">
          <p class="caso-meta">Impulse · AHF Argentina · 2025 · Conversational Design</p>
          <h2 class="caso-titulo">Impulse Bot</h2>
          <p class="caso-desc">El primer chatbot de Argentina dedicado 100% a salud sexual. 2,249 mensajes intercambiados, 82% de opt-in, dos olas de activación en el calendario LGBTIQ+.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

    </section>
  </div>

  <script>
    if (sessionStorage.getItem('portfolio-auth') === 'true') {
      const content = document.getElementById('portfolio-content');
      if (content) content.style.display = 'block';
    }
  </script>

</Layout>

<style>
  .page-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 3rem);
  }

  /* ── HEADER ── */
  .portfolio-header {
    padding: 2.5rem 0 1.5rem;
  }

  .eyebrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0;
  }

  .page-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f0f0f0;
    margin: 0.75rem 0 0;
  }

  /* ── GRILLA DE CASOS ── */
  .casos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 10rem;
  }

  /* ── FEATURED CARD ── */
  .caso-featured {
    grid-column: 1 / -1;
    display: grid !important;
    grid-template-columns: 3fr 2fr;
    align-items: stretch;
  }

  .caso-featured .caso-media {
    aspect-ratio: unset;
    min-height: 380px;
    border-radius: 0;
  }

  .caso-featured .caso-info {
    padding: 2.5rem 2.5rem 2.5rem 2.5rem;
    justify-content: center;
    gap: 0;
  }

  .caso-featured .caso-titulo {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-top: 1rem;
  }

  .caso-featured .caso-desc {
    margin-top: 1rem;
    font-size: 1rem;
  }

  .caso-featured .caso-cta {
    margin-top: 2rem;
    align-self: flex-start;
  }

  /* ── CARD BASE ── */
  .caso-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #141414;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
  }

  .caso-card:hover {
    transform: translateY(-4px);
    background: #1a1a1a;
  }

  .caso-media {
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-media video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .caso-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caso-info {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .caso-meta {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0;
  }

  .caso-titulo {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #f0f0f0;
    line-height: 1.2;
    margin: 0.75rem 0 0;
  }

  .caso-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.9375rem;
    color: #a0a0a0;
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .caso-cta {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    color: #6b6b6b;
    margin: 1.25rem 0 0;
    align-self: flex-end;
    transition: color 0.2s ease;
  }

  .caso-card:hover .caso-cta {
    color: #f0f0f0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .casos {
      grid-template-columns: 1fr 1fr;
    }

    .caso-featured {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }

    .caso-featured .caso-media {
      aspect-ratio: 16 / 9;
      min-height: unset;
    }
  }

  @media (max-width: 600px) {
    .casos {
      grid-template-columns: 1fr;
      margin-bottom: 6rem;
    }

    .caso-featured {
      grid-template-columns: 1fr;
    }
  }

  /* ── SECCIÓN PÚBLICA ── */
  .casos-publicos {
    display: block;
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(240, 240, 240, 0.06);
  }

  .publicos-header {
    margin-bottom: 2rem;
  }

  .caso-media-impulse {
    background: #0d1a2b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .impulse-visual {
    font-size: 3rem;
    opacity: 0.5;
  }
</style>
