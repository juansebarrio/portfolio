---
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';

export const prerender = false;
---

<Layout title="Portfolio — Juanse Barrio" description="Casos de estudio de Juan Segundo Barrio: diseño, IA y research en productos digitales de Banco Galicia.">

  <PasswordGate autoShow={true} />

  <div id="portfolio-content" style="display:none">
  <div class="page-container">

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="hero-grid">

        <div class="hero-texto">
          <p class="eyebrow">PORTFOLIO</p>
          <h1 class="hero-title">Casos de estudio</h1>
          <p class="hero-sub">Cuatro proyectos de Banco Galicia donde diseño, IA y research se cruzan. Algunos se enviaron a producción, otros son exploraciones internas con impacto medible.</p>
        </div>

        <div class="hero-video">
          <video
            src="/images/portfolio/upgrade/07-video-final.mov"
            autoplay
            muted
            loop
            playsinline
          ></video>
        </div>

      </div>
    </section>

    <!-- ── DIVIDER ── -->
    <div class="section-divider">
      <span class="divider-label">CASOS</span>
    </div>

    <!-- ── GRILLA DE CASOS ── -->
    <section class="casos">

      <!-- Caso 1: CSAT semántico -->
      <a href="/portfolio/csat-semantico" class="caso-card">
        <div class="caso-media">
          <img
            src="/images/portfolio/csat-semantico/csat-tile.webp"
            alt="Juanse presentando los resultados del análisis CSAT a una audiencia de Galicia Design"
            loading="lazy"
            width="1600"
            height="1000"
          />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2026 · IA + Research</p>
          <h2 class="caso-titulo">Convertir la voz del cliente en un backlog accionable</h2>
          <p class="caso-desc">Sistema mensual que clasifica cientos de comentarios de CSAT con una taxonomía propia asistida por IA y los entrega como backlog priorizado por squad.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 2: Upgrade (con video) -->
      <a href="/portfolio/upgrade" class="caso-card">
        <div class="caso-media">
          <video
            src="/images/portfolio/upgrade/07-video-final.mov"
            autoplay
            muted
            loop
            playsinline
          ></video>
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2026 · Product Design</p>
          <h2 class="caso-titulo">El upgrade más rápido del sistema financiero argentino</h2>
          <p class="caso-desc">Rediseño nativo del flujo de upgrade de paquetes: de una webview inconsistente a tres pasos sin fricción.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 3: Rediseño cuentas -->
      <a href="/portfolio/rediseno-cuentas" class="caso-card">
        <div class="caso-media">
          <img src="/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg" alt="Taller de alineación entre bancas: equipo revisando pantallas del rediseño en monitores grandes" loading="lazy" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2025 · Rediseño</p>
          <h2 class="caso-titulo">Diseñando cuentas desde cero</h2>
          <p class="caso-desc">Rediseño completo del flujo de cuentas, la funcionalidad más usada por los clientes del banco.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

      <!-- Caso 4: PFM -->
      <a href="/portfolio/pfm" class="caso-card">
        <div class="caso-media">
          <img src="/images/portfolio/pfm/pfm-card-preview.jpg" alt="Testeo guerrilla en sucursal: una persona usando el PFM en el celular mientras el equipo toma notas" loading="lazy" />
        </div>
        <div class="caso-info">
          <p class="caso-meta">Banco Galicia · 2024 · Product Design</p>
          <h2 class="caso-titulo">El primer PFM argentino hecho por un banco</h2>
          <p class="caso-desc">Personal Finance Manager diseñado desde research: cuatro perfiles, cuatro formas de relacionarse con la plata.</p>
          <p class="caso-cta">Ver caso →</p>
        </div>
      </a>

    </section>

  </div>
  </div>

  <script>
    if (sessionStorage.getItem('portfolio-auth') === 'true') {
      const content = document.getElementById('portfolio-content');
      if (content) content.style.display = 'block';
    }
  </script>

</Layout>

<style>
  .page-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 3rem);
  }

  /* ── HERO ── */
  .hero {
    padding-top: 1.25rem;
    padding-bottom: 0.75rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: center;
  }

  .eyebrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0;
  }

  .hero-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #f0f0f0;
    margin: 1.5rem 0 0;
  }

  .hero-sub {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.125rem;
    color: #a0a0a0;
    max-width: 32rem;
    line-height: 1.5;
    margin: 2rem 0 0;
  }

  .hero-video {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-video video {
    height: 70vh;
    width: auto;
    max-width: 100%;
    display: block;
    border-radius: 24px;
  }

  /* ── DIVIDER ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0.625rem 0 0;
  }

  .section-divider::before,
  .section-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #2a2a2a;
  }

  .divider-label {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4a4a4a;
    white-space: nowrap;
  }

  /* ── GRILLA DE CASOS ── */
  .casos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 0.75rem;
    margin-bottom: 10rem;
  }

  .caso-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #141414;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
  }

  .caso-card:hover {
    transform: translateY(-4px);
    background: #1a1a1a;
  }

  .caso-media {
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-media video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .caso-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caso-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-placeholder span {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .caso-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .caso-meta {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0;
  }

  .caso-titulo {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #f0f0f0;
    line-height: 1.2;
    margin: 0.75rem 0 0;
  }

  .caso-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.9375rem;
    color: #a0a0a0;
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .caso-cta {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    color: #6b6b6b;
    margin: 1.5rem 0 0;
    align-self: flex-end;
    transition: color 0.2s ease;
  }

  .caso-card:hover .caso-cta {
    color: #f0f0f0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid .hero-video {
      order: -1;
    }

    .hero-video video {
      height: 60vh;
    }

    .casos {
      grid-template-columns: 1fr;
      margin-top: 5rem;
      margin-bottom: 6rem;
    }
  }
</style>
