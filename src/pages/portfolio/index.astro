---
import Layout from '../../layouts/Layout.astro';
import PortadaEmbed from '../../components/PortadaEmbed.astro';

export const prerender = false;
---

<Layout title="Portfolio — Juanse Barrio" description="Casos de estudio de Juan Segundo Barrio: diseño de productos digitales, IA aplicada y research.">

  <div class="page-container">

    <div class="portfolio-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 class="page-title">Casos de estudio</h1>
    </div>

    <!-- ── CASOS NDA ── -->
    <section class="nda-section">

      <!-- Estado cerrado — visible si no está auth'd -->
      <div class="nda-lock" id="nda-lock">
        <div class="lock-body">
          <div class="lock-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="lock-eyebrow">4 CASOS · BANCO GALICIA · NDA</p>
          <p class="lock-desc">Product Design, IA y Research en la app de uno de los tres bancos más grandes de Argentina.</p>
          <button class="lock-btn" id="unlock-btn">
            Ver los casos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <form id="inline-gate" class="inline-gate" style="display:none" novalidate>
            <input type="password" id="inline-input" class="inline-input" placeholder="Contraseña" autocomplete="current-password" />
            <p id="inline-error" class="inline-error" hidden>Contraseña incorrecta</p>
            <button type="submit" class="inline-submit">Acceder</button>
          </form>
          <p class="lock-recruiter">
            ¿Sos recruiter y no tenés la contraseña? Escribime a
            <a href="mailto:contacto@juansebarrio.com?subject=Acceso%20a%20los%20casos%20bajo%20NDA">contacto@juansebarrio.com</a> →
          </p>
        </div>
        <div class="lock-preview" aria-hidden="true">
          <div class="preview-card preview-featured"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
          <div class="preview-card"></div>
        </div>
      </div>

      <!-- Casos desbloqueados — ocultos hasta auth -->
      <div id="nda-content" style="display:none">
        <div class="portfolio-header-inner">
          <p class="eyebrow">CASOS BAJO NDA</p>
        </div>
        <div class="casos">

          <a href="/portfolio/csat-semantico" class="caso-card caso-featured">
            <div class="caso-media">
              <img
                src="/images/portfolio/csat-semantico/csat-tile.webp"
                alt="Juanse presentando los resultados del análisis CSAT a una audiencia de Galicia Design"
                loading="lazy"
                width="1600"
                height="1000" decoding="async" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · IA + Research</p>
              <h2 class="caso-titulo">Convertir la voz del cliente en un backlog accionable</h2>
              <p class="caso-desc">Sistema mensual que clasifica cientos de comentarios de CSAT con una taxonomía propia asistida por IA y los entrega como backlog priorizado por squad.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/upgrade" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/upgrade/07-video-poster.webp" alt="Pantalla final del flujo de upgrade rediseñado" loading="lazy" decoding="async" width="1384" height="720" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2026 · Product Design</p>
              <h2 class="caso-titulo">Un problema de conversión que era un problema de medición</h2>
              <p class="caso-desc">Rediseño nativo del flujo de upgrade de paquetes: evaluación de oferta como prerrequisito y flujo de 3 pasos.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/rediseno-cuentas" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/rediseno-cuentas/rediseno-card-preview.jpg" alt="Taller de alineación entre bancas: equipo revisando pantallas del rediseño en monitores grandes" loading="lazy" decoding="async" width="1920" height="1440" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2025 · Rediseño</p>
              <h2 class="caso-titulo">Diseñando cuentas desde cero</h2>
              <p class="caso-desc">Rediseño completo del flujo de cuentas, la funcionalidad más usada por los clientes del banco.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

          <a href="/portfolio/pfm" class="caso-card">
            <div class="caso-media">
              <img src="/images/portfolio/pfm/pfm-card-preview.jpg" alt="Testeo guerrilla en sucursal: una persona usando el PFM en el celular mientras el equipo toma notas" loading="lazy" decoding="async" width="1920" height="1080" />
            </div>
            <div class="caso-info">
              <p class="caso-meta">Banco Galicia · 2024 · Product Design</p>
              <h2 class="caso-titulo">Diseñar para un hábito que ya existía</h2>
              <p class="caso-desc">Personal Finance Manager diseñado desde research: cuatro perfiles, cuatro formas de relacionarse con la plata.</p>
              <p class="caso-cta">Ver caso →</p>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- ── PROYECTOS PÚBLICOS ── -->
    <section class="casos-publicos">
      <div class="publicos-header">
        <p class="eyebrow">Soluciones con IA</p>
      </div>

      <div class="casos-destacados">

        <!-- Fin de mes (PFM) — card destacada -->
        <a href="/portfolio/fin-de-mes" class="caso-card">
          <div class="caso-media caso-media-pfm">
            <PortadaEmbed file="portada-fin-de-mes.html" title="Fin de mes" bg="#141312" />
          </div>
          <div class="caso-info">
            <p class="caso-meta">JS80 · 2026 · Finanzas personales</p>
            <h2 class="caso-titulo">Fin de mes</h2>
            <p class="caso-desc">PFM personal y del hogar hecho para Argentina: presupuesto por partidas, tarjetas con ciclos reales, cuotas y patrimonio.</p>
            <p class="caso-cta">Ver caso →</p>
          </div>
        </a>

        <!-- AURE — card destacada -->
        <a href="/portfolio/aure" class="caso-card">
          <div class="caso-media caso-media-aure">
            <PortadaEmbed file="portada-aure.html" title="AURE" bg="#212A45" />
          </div>
          <div class="caso-info">
            <p class="caso-meta">JS80 · 2026 · Real Estate</p>
            <h2 class="caso-titulo">AURE</h2>
            <p class="caso-desc">Web de comercialización inmobiliaria en Buenos Aires, con la cartera sincronizada desde Tokko Broker.</p>
            <p class="caso-cta">Ver caso →</p>
          </div>
        </a>

        <!-- Impulse Bot — card destacada -->
        <a href="/portfolio/impulse-bot" class="caso-card">
          <div class="caso-media caso-media-impulse">
            <PortadaEmbed file="portada-impulse-bot.html" title="Impulse Bot" bg="#1C0E0A" />
          </div>
          <div class="caso-info">
            <p class="caso-meta">Impulse · AHF Argentina · 2025 · Conversational Design</p>
            <h2 class="caso-titulo">Impulse Bot</h2>
            <p class="caso-desc">El primer chatbot de Argentina dedicado 100% a salud sexual. 2,249 mensajes intercambiados, 82% de opt-in.</p>
            <p class="caso-cta">Ver caso →</p>
          </div>
        </a>

      </div>

    </section>

  </div>

  <script>
    const STORAGE_KEY = 'portfolio-auth';
    const PASSWORD = 'libertador123456';
    const ACCESS_KEY = '51867e76';

    function applyAuth() {
      const lock = document.getElementById('nda-lock');
      const content = document.getElementById('nda-content');
      if (lock) lock.style.display = 'none';
      if (content) content.style.display = 'block';
    }

    if (new URLSearchParams(window.location.search).get('key') === ACCESS_KEY) {
      sessionStorage.setItem(STORAGE_KEY, 'true');
      history.replaceState(null, '', window.location.pathname);
    }

    if (sessionStorage.getItem(STORAGE_KEY) === 'true') applyAuth();

    const unlockBtn = document.getElementById('unlock-btn');
    const inlineGate = document.getElementById('inline-gate');
    const inlineInput = document.getElementById('inline-input');
    const inlineError = document.getElementById('inline-error');

    function showInlineForm() {
      if (unlockBtn) unlockBtn.style.display = 'none';
      if (inlineGate) inlineGate.style.display = 'flex';
      setTimeout(() => inlineInput?.focus(), 50);
    }

    unlockBtn?.addEventListener('click', showInlineForm);

    if (new URLSearchParams(window.location.search).get('unlock') === '1') {
      showInlineForm();
    }

    inlineGate?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inlineInput.value === PASSWORD) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        applyAuth();
      } else {
        inlineError.hidden = false;
        inlineInput.value = '';
        inlineInput.focus();
      }
    });
  </script>

</Layout>

<style>
  .page-container { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1.5rem, 5vw, 3rem); }

  .portfolio-header { padding: 2.5rem 0 2rem; }
  .portfolio-header-inner { padding: 0 0 1.5rem; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0.75rem 0 0;
  }

  /* ── NDA lock state ── */
  .nda-section { margin-bottom: 2rem; }

  .nda-lock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 2rem;
  }

  .lock-body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .lock-icon-wrap {
    width: 40px;
    height: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }

  .lock-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .lock-desc {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 28rem;
  }

  .lock-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.5rem;
  }

  .lock-btn:hover { background: var(--bg); color: var(--fg); transform: translateY(-1px); }

  .inline-gate {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
  }

  .lock-recruiter {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  .lock-recruiter a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .inline-input {
    padding: 0.75rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .inline-input:focus { border-color: var(--fg); }

  .inline-error {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #ff4444;
    margin: 0;
  }

  .inline-submit {
    align-self: flex-start;
    padding: 0.75rem 1.25rem;
    background: var(--fg);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .inline-submit:hover { background: var(--bg); color: var(--fg); }

  /* Preview grid of ghost cards */
  .lock-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    height: 260px;
  }

  .preview-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .preview-featured {
    grid-column: 1 / -1;
    height: auto;
  }

  /* ── Casos grid ── */
  .casos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .caso-featured {
    grid-column: 1 / -1;
    display: grid !important;
    grid-template-columns: 3fr 2fr;
    align-items: stretch;
  }

  .caso-featured .caso-media { aspect-ratio: unset; min-height: 380px; border-radius: 0; }
  .caso-featured .caso-info { padding: 2.5rem; justify-content: center; gap: 0; }
  .caso-featured .caso-titulo { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-top: 1rem; }
  .caso-featured .caso-desc { margin-top: 1rem; font-size: 1rem; }
  .caso-featured .caso-cta { margin-top: 2rem; align-self: flex-start; }

  .caso-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 300ms ease, background 300ms ease;
  }

  .caso-card:hover { transform: translateY(-4px); background: var(--surface); }

  .caso-media {
    aspect-ratio: 16 / 10;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .caso-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .caso-info { padding: 1.75rem; display: flex; flex-direction: column; }

  .caso-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  .caso-titulo {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.2;
    margin: 0.75rem 0 0;
  }

  .caso-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0.75rem 0 0;
  }

  .caso-cta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 1.25rem 0 0;
    align-self: flex-end;
    transition: color 0.2s ease;
  }

  .caso-card:hover .caso-cta { color: var(--fg); }

  /* ── Públicos ── */
  .casos-publicos {
    padding-top: 3.5rem;
    border-top: 1px solid var(--hairline);
    padding-bottom: 8rem;
  }

  .publicos-header { margin-bottom: 1.5rem; }

  /* ── Cards destacadas: 3 columnas en desktop ── */
  .casos-destacados {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Aspect ratios iguales para que ambas cards queden a la misma altura.
     16/9 + padding del info da un total más compacto. */
  /* Las tres portadas son animaciones embebidas (public/portadas/): el
     iframe pinta todo el bloque, no hay <img> que encuadrar. */
  .caso-media-impulse { background: #1C0E0A; aspect-ratio: 16 / 9; display: block; }
  .caso-media-aure    { background: #212A45; aspect-ratio: 16 / 9; display: block; }
  .caso-media-pfm     { background: #141312; aspect-ratio: 16 / 9; display: block; }

  .casos-destacados .caso-info { padding: 1.5rem; }
  .casos-destacados .caso-titulo { font-size: 1.125rem; margin-top: 0.5rem; }
  .casos-destacados .caso-desc { font-size: 0.9375rem; margin-top: 0.5rem; }
  .casos-destacados .caso-cta { margin-top: 1rem; }

  @media (max-width: 900px) {
    .casos-destacados { grid-template-columns: 1fr; }
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nda-lock { grid-template-columns: 1fr; }
    .lock-preview { display: none; }
    .casos { grid-template-columns: 1fr 1fr; }
    .caso-featured { grid-column: 1 / -1; grid-template-columns: 1fr; }
    .caso-featured .caso-media { aspect-ratio: 16 / 9; min-height: unset; }
  }

  @media (max-width: 600px) {
    .nda-lock { padding: 2rem; }
    .casos { grid-template-columns: 1fr; }
    .caso-featured { grid-template-columns: 1fr; }
  }
</style>
