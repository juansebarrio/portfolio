---
import Layout from '../layouts/Layout.astro';

const heroVideos = [
  { id: '1191384379', title: 'Arte como activismo — pieza 1' },
  { id: '1193278401', title: 'Arte como activismo — pieza 2' },
  { id: '1193278648', title: 'Arte como activismo — pieza 3' },
];
---

<Layout
  title="Arte como activismo — Juanse Barrio"
  description="Fotografía, performance y proyectos multimediales que usan el arte para instalar conversaciones sobre salud, identidad y disidencia."
>

  <div class="arte-container">

    <!-- ── HERO: 3 videos verticales ── -->
    <section class="arte-hero">
      <div class="arte-hero-videos">
        {heroVideos.map((v) => (
          <div class="arte-video-wrap">
            <iframe
              src={`https://player.vimeo.com/video/${v.id}?title=0&byline=0&portrait=0`}
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
              allowfullscreen
              loading="eager"
              title={v.title}
            ></iframe>
          </div>
        ))}
      </div>
    </section>

    <!-- ── TÍTULO ── -->
    <section class="arte-intro">
      <p class="arte-eyebrow">Trabajo público · Fotografía · Performance · Multimedia</p>
      <h1 class="arte-title">Arte como activismo</h1>
      <p class="arte-bajada">
        La cámara, el cuerpo y la escena como herramientas para abrir
        conversaciones que la institución suele dejar afuera.
      </p>
    </section>

    <!-- ── TEXTO PRINCIPAL ── -->
    <section class="arte-prosa">
      <p>
        Mi trabajo artístico explora <strong>salud, identidad y disidencia sexual</strong>
        a través de la fotografía, la performance y proyectos multimediales.
        Algunas obras llegaron a salas como la Legislatura de la Ciudad de
        Buenos Aires; otras viven en redes, en marchas o en pantallas de WhatsApp.
        Lo que comparten es la convicción de que el arte no decora: instala
        temas, habilita conversaciones y agita estructuras.
      </p>
      <p>
        Cada proyecto nace de una pregunta concreta — ¿qué cuerpos se cuentan,
        qué historias se nombran, qué espacios se ocupan? — y se traduce en
        imagen, performance o pieza multimedial.
      </p>
      <p>
        Hoy estoy trabajando en <strong>obras teatrales y proyectos
        multimediales</strong> que extienden esta búsqueda hacia el escenario
        y la pantalla. Más novedades pronto.
      </p>
    </section>

    <!-- ── BANNER SUTIL: VIVIR ── -->
    <a href="/vivir" class="vivir-banner">
      <div class="vivir-banner-text">
        <span class="vivir-banner-eyebrow">Proyecto destacado</span>
        <span class="vivir-banner-title">VIVIR</span>
        <span class="vivir-banner-desc">Serie fotográfica sobre VIH, cuerpo y disidencia.</span>
      </div>
      <span class="vivir-banner-arrow" aria-hidden="true">→</span>
    </a>

    <!-- ── NAV ── -->
    <nav class="arte-nav">
      <a href="/" class="arte-nav-link">← Volver al inicio</a>
    </nav>

  </div>

</Layout>

<style>
  .arte-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 3rem);
  }

  /* ── Hero videos ── */
  .arte-hero {
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .arte-hero-videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .arte-video-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    background: #0e0e0e;
    border-radius: 16px;
    overflow: hidden;
  }

  .arte-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Intro ── */
  .arte-intro {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 0 1rem;
    text-align: center;
  }

  .arte-eyebrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 1.5rem;
  }

  .arte-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #f0f0f0;
    margin: 0 0 1.5rem;
  }

  .arte-bajada {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: #a0a0a0;
    margin: 0 auto;
    max-width: 38rem;
  }

  /* ── Prosa ── */
  .arte-prosa {
    max-width: 44rem;
    margin: 4rem auto 0;
  }

  .arte-prosa p {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #c0c0c0;
    margin: 0 0 1.5rem;
  }

  .arte-prosa p:last-child {
    margin-bottom: 0;
  }

  .arte-prosa strong {
    color: #f0f0f0;
    font-weight: 500;
  }

  /* ── Banner Vivir (sutil) ── */
  .vivir-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 44rem;
    margin: 4rem auto 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    background: #141414;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .vivir-banner:hover {
    border-color: #3a3a3a;
    background: #181818;
  }

  .vivir-banner-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .vivir-banner-eyebrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .vivir-banner-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #f0f0f0;
    letter-spacing: 0.02em;
  }

  .vivir-banner-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    color: #a0a0a0;
    line-height: 1.5;
  }

  .vivir-banner-arrow {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.25rem;
    color: #6b6b6b;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .vivir-banner:hover .vivir-banner-arrow {
    color: #f0f0f0;
    transform: translateX(4px);
  }

  /* ── Nav ── */
  .arte-nav {
    display: flex;
    padding: 4rem 0 6rem;
  }

  .arte-nav-link {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b6b6b;
    text-decoration: none;
    transition: color 0.2s;
  }

  .arte-nav-link:hover {
    color: #f0f0f0;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .arte-hero {
      padding-top: 4rem;
      padding-bottom: 2.5rem;
    }

    .arte-hero-videos {
      gap: 0.75rem;
    }

    .arte-intro {
      text-align: left;
    }

    .vivir-banner {
      flex-direction: row;
      padding: 1rem 1.25rem;
    }

    .vivir-banner-title {
      font-size: 1rem;
    }
  }
</style>
