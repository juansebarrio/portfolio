---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Juan Segundo Barrio', description = 'Portafolio de Juan Segundo Barrio' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/experiencia', label: 'Experiencia' },
  { href: '/portfolio', label: 'Portfolio' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">

    <header class="sticky top-0 z-50 border-b border-white/5" style="background-color: rgba(10,10,10,0.85); backdrop-filter: blur(12px);">
      <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">

        <div class="flex items-center gap-8 flex-1">
          <a
            href="/"
            class="text-sm tracking-wide transition-colors duration-200"
            style={currentPath === '/' ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            Inicio
          </a>
        </div>

        <a href="/" class="font-heading text-base font-semibold tracking-tight whitespace-nowrap" style="font-family: 'Syne', system-ui, sans-serif;">
          Juan Segundo Barrio
        </a>

        <div class="flex items-center gap-8 flex-1 justify-end">
          <a
            href="/experiencia"
            class="text-sm tracking-wide transition-colors duration-200"
            style={currentPath === '/experiencia' ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            Experiencia
          </a>
          <a
            href="/portfolio"
            class="text-sm tracking-wide transition-colors duration-200"
            style={currentPath === '/portfolio' ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            Portfolio
          </a>
          <a
            href="/js80"
            class="text-sm tracking-wide transition-colors duration-200"
            style={currentPath === '/js80' ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
            aria-label="JS80 Studio"
          >
            <span style="display:inline-flex; align-items:center; gap:6px;">
              <svg width="14" height="14" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0; display:block;">
                <defs>
                  <radialGradient id="js80-nav-g" cx="35%" cy="35%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
                    <stop offset="45%" stop-color="#6B8CFF"/>
                    <stop offset="100%" stop-color="#8B6FFF"/>
                  </radialGradient>
                </defs>
                <circle cx="50" cy="50" r="44" fill="url(#js80-nav-g)"/>
              </svg>
              JS80
            </span>
          </a>
        </div>

      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/5 py-8 px-6">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-4 flex-wrap">

        <div style="display:flex; align-items:center; gap:1.25rem;">
          <span class="text-xs" style="color: #6b6b6b;">© {new Date().getFullYear()} Juan Segundo Barrio</span>
          <a href="https://www.linkedin.com/in/juansebarrio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style="color: #6b6b6b; display:flex; align-items:center; transition: color 0.2s;" onmouseover="this.style.color='#f0f0f0'" onmouseout="this.style.color='#6b6b6b'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:contacto@juansebarrio.com" aria-label="Enviar email" style="color: #6b6b6b; display:flex; align-items:center; transition: color 0.2s;" onmouseover="this.style.color='#f0f0f0'" onmouseout="this.style.color='#6b6b6b'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 7 10-7"/>
            </svg>
          </a>
        </div>

        <span class="text-xs" style="color: #4a4a4a; max-width: 32rem; text-align: right; line-height: 1.5;">
          Los casos bajo NDA son confidenciales. Su acceso implica aceptar no compartir ni reproducir el contenido.
        </span>

      </div>
    </footer>

    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>
