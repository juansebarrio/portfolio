---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title = 'Juan Segundo Barrio',
  description = 'Portafolio de Juan Segundo Barrio',
  ogImage = '/og-image.jpg',
  ogType = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/') || currentPath === '/en';
const prefix = isEnglish ? '/en' : '';
const basePath = isEnglish ? (currentPath.replace(/^\/en/, '') || '/') : currentPath;

const switchPath = isEnglish
  ? basePath
  : (currentPath === '/' ? '/en' : '/en' + currentPath);
const switchLabel = isEnglish ? 'ES' : 'EN';

const SITE = 'https://juansebarrio.com';
const canonicalUrl = new URL(currentPath, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
const esUrl = `${SITE}${basePath === '/' ? '' : basePath}`;
const enUrl = `${SITE}/en${basePath === '/' ? '' : basePath}`;

// BreadcrumbList JSON-LD computado desde la URL.
// Sólo se emite en páginas con profundidad >= 1 (no en home).
const segmentLabels: Record<string, { es: string; en: string }> = {
  portfolio:   { es: 'Portfolio',   en: 'Portfolio' },
  experiencia: { es: 'Experiencia', en: 'Experience' },
  js80:        { es: 'JS80',        en: 'JS80' },
};
const segments = basePath.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const pageTitle = title.split(' — ')[0].split(' · ')[0].trim();
const homeLabel = isEnglish ? 'Home' : 'Inicio';

const breadcrumbItems = segments.length > 0
  ? [
      { '@type': 'ListItem', position: 1, name: homeLabel, item: isEnglish ? `${SITE}/en` : SITE },
      ...segments.map((seg, idx) => {
        const isLast = idx === segments.length - 1;
        const url = `${SITE}${isEnglish ? '/en' : ''}/${segments.slice(0, idx + 1).join('/')}`;
        const known = segmentLabels[seg];
        const name = isLast ? pageTitle : (known ? known[isEnglish ? 'en' : 'es'] : seg);
        return { '@type': 'ListItem', position: idx + 2, name, item: url };
      }),
    ]
  : null;

const homeHref    = isEnglish ? '/en' : '/';
const expHref     = `${prefix}/experiencia`;
const portHref    = `${prefix}/portfolio`;
const js80Href    = `${prefix}/js80`;
const cardioHref  = `${prefix}/js80/cardiologia-barrio-scarano`;
const turneroHref = `${prefix}/js80/turnero-digital`;

const homeActive    = basePath === '/';
const expActive     = basePath === '/experiencia';
const portActive    = basePath.startsWith('/portfolio');
const js80Active    = basePath === '/js80' || basePath.startsWith('/js80/');
const cardioActive  = basePath === '/js80/cardiologia-barrio-scarano';
const turneroActive = basePath === '/js80/turnero-digital';
const js80OverviewActive = basePath === '/js80';

const L = isEnglish
  ? { home: 'Home', exp: 'Experience', port: 'Portfolio', studio: 'JS80 Studio', products: 'Custom Products' }
  : { home: 'Inicio', exp: 'Experiencia', port: 'Portfolio', studio: 'Estudio JS80', products: 'Productos a medida' };
---

<!doctype html>
<html lang={isEnglish ? 'en' : 'es'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-AR" href={esUrl} />
    <link rel="alternate" hreflang="en-US" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Juan Segundo Barrio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'es_AR'} />
    <meta property="og:locale:alternate" content={isEnglish ? 'es_AR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/syne/v24/8vIS7w4qzmVxsWxjBZRjr0FKM_3fvg6jTY8.woff2"
      crossorigin
    />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />

    {breadcrumbItems && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbItems,
        })}
      />
    )}

    <slot name="head" />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-Eb0eVpXKn3crloCY9jzDQ.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="min-h-screen flex flex-col">

    <header class="sticky top-0 z-50 border-b border-white/5" style="background-color: rgba(10,10,10,0.85); backdrop-filter: blur(12px);">
      <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">

        <!-- Desktop: Home/Inicio (izq) -->
        <div class="nav-desktop flex items-center gap-8 flex-1">
          <a
            href={homeHref}
            class="text-sm tracking-wide transition-colors duration-200"
            style={homeActive ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            {L.home}
          </a>
        </div>

        <!-- Centro: nombre -->
        <a href={homeHref} class="font-heading text-base font-semibold tracking-tight whitespace-nowrap" style="font-family: 'Syne', system-ui, sans-serif;">
          Juan Segundo Barrio
        </a>

        <!-- Desktop: links (der) -->
        <div class="nav-desktop flex items-center gap-8 flex-1 justify-end">
          <a
            href={expHref}
            class="text-sm tracking-wide transition-colors duration-200"
            style={expActive ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            {L.exp}
          </a>
          <a
            href={portHref}
            class="text-sm tracking-wide transition-colors duration-200"
            style={portActive ? 'color: #f0f0f0;' : 'color: #6b6b6b;'}
          >
            {L.port}
          </a>
          <div class="js80-dropdown" data-js80-dropdown>
            <button
              type="button"
              id="js80-trigger"
              class="js80-trigger text-sm tracking-wide transition-colors duration-200"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="js80-menu"
              style={`color: ${js80Active ? '#f0f0f0' : '#6b6b6b'};`}
            >
              <svg width="14" height="14" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0; display:block;">
                <defs>
                  <radialGradient id="js80-nav-g" cx="35%" cy="35%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
                    <stop offset="45%" stop-color="#6B8CFF"/>
                    <stop offset="100%" stop-color="#8B6FFF"/>
                  </radialGradient>
                </defs>
                <circle cx="50" cy="50" r="44" fill="url(#js80-nav-g)"/>
              </svg>
              JS80
              <svg class="js80-chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div
              id="js80-menu"
              class="js80-menu"
              role="menu"
              aria-labelledby="js80-trigger"
            >
              <a
                href={js80Href}
                role="menuitem"
                class="js80-menu-overview"
                style={js80OverviewActive ? 'color: #f0f0f0;' : ''}
              >
                {L.studio}
              </a>
              <div class="js80-menu-divider"></div>
              <div class="js80-menu-label">{L.products}</div>
              <a
                href={cardioHref}
                role="menuitem"
                class="js80-menu-item"
                style={cardioActive ? 'color: #f0f0f0;' : ''}
              >
                Cardiología B·S
              </a>
              <a
                href={turneroHref}
                role="menuitem"
                class="js80-menu-item"
                style={turneroActive ? 'color: #f0f0f0;' : ''}
              >
                Turnero Digital
              </a>
            </div>
          </div>
          <a
            href={switchPath}
            class="text-sm tracking-wide transition-colors duration-200 lang-switch"
            style="color: #6b6b6b; border: 1px solid rgba(240,240,240,0.12); padding: 2px 8px; border-radius: 3px; font-size: 0.75rem; letter-spacing: 0.08em;"
            aria-label={isEnglish ? 'Switch to Spanish' : 'Switch to English'}
          >
            {switchLabel}
          </a>
        </div>

        <!-- Mobile: botón hamburguesa -->
        <button
          id="nav-toggle"
          class="nav-mobile"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="nav-mobile-menu"
          style="background:none; border:none; cursor:pointer; padding:4px; color:#6b6b6b; display:flex; align-items:center; justify-content:center;"
        >
          <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="2" y1="5" x2="18" y2="5"/>
            <line x1="2" y1="10" x2="18" y2="10"/>
            <line x1="2" y1="15" x2="18" y2="15"/>
          </svg>
          <svg id="nav-icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:none;">
            <line x1="4" y1="4" x2="16" y2="16"/>
            <line x1="16" y1="4" x2="4" y2="16"/>
          </svg>
        </button>

      </nav>

      <!-- Mobile menu -->
      <div
        id="nav-mobile-menu"
        style="display:none; border-top: 1px solid rgba(255,255,255,0.05);"
      >
        <div style="padding: 8px 24px 16px; display:flex; flex-direction:column; gap:0;">
          {[
            { href: homeHref, label: L.home, active: homeActive },
            { href: expHref, label: L.exp, active: expActive },
            { href: portHref, label: L.port, active: portActive },
          ].map(link => (
            <a
              href={link.href}
              style={`display:block; padding: 14px 0; font-size:0.9375rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: ${link.active ? '#f0f0f0' : '#6b6b6b'}; text-decoration:none; transition: color 0.2s;`}
            >
              {link.label}
            </a>
          ))}
          <a
            href={js80Href}
            style={`display:flex; align-items:center; gap:8px; padding: 14px 0; font-size:0.9375rem; color: ${js80OverviewActive ? '#f0f0f0' : '#6b6b6b'}; text-decoration:none; transition: color 0.2s; border-bottom: 1px solid rgba(255,255,255,0.04);`}
          >
            <svg width="14" height="14" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0; display:block;">
              <defs>
                <radialGradient id="js80-mob-g" cx="35%" cy="35%">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
                  <stop offset="45%" stop-color="#6B8CFF"/>
                  <stop offset="100%" stop-color="#8B6FFF"/>
                </radialGradient>
              </defs>
              <circle cx="50" cy="50" r="44" fill="url(#js80-mob-g)"/>
            </svg>
            {L.studio}
          </a>

          <p style="margin: 14px 0 6px; font-size: 0.6875rem; letter-spacing: 0.18em; text-transform: uppercase; color: #4a4a4a; font-weight: 500;">
            {L.products}
          </p>
          <a
            href={cardioHref}
            style={`display:block; padding: 10px 0 10px 22px; font-size:0.875rem; color: ${cardioActive ? '#f0f0f0' : '#6b6b6b'}; text-decoration:none; transition: color 0.2s;`}
          >
            Cardiología B·S
          </a>
          <a
            href={turneroHref}
            style={`display:block; padding: 10px 0 10px 22px; font-size:0.875rem; color: ${turneroActive ? '#f0f0f0' : '#6b6b6b'}; text-decoration:none; transition: color 0.2s; border-bottom: 1px solid rgba(255,255,255,0.04);`}
          >
            Turnero Digital
          </a>
          <a
            href={switchPath}
            style={`display:block; padding: 14px 0; font-size:0.8125rem; letter-spacing: 0.08em; color: #6b6b6b; text-decoration:none; border-top: 1px solid rgba(255,255,255,0.04);`}
          >
            {isEnglish ? '→ Español' : '→ English'}
          </a>
        </div>
      </div>
    </header>

    <style>
      .nav-mobile { display: none !important; }

      @media (max-width: 640px) {
        .nav-desktop { display: none !important; }
        .nav-mobile  { display: flex !important; }
      }

      /* ── JS80 dropdown (desktop) ── */
      .js80-dropdown {
        position: relative;
      }

      .js80-trigger {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        font: inherit;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        line-height: 1;
      }

      .js80-trigger:hover {
        color: #f0f0f0 !important;
      }

      .js80-chevron {
        opacity: 0.7;
        transition: transform 0.2s ease;
        margin-top: 1px;
      }

      .js80-dropdown.is-open .js80-chevron {
        transform: rotate(180deg);
      }

      .js80-menu {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        min-width: 220px;
        background-color: rgba(14, 14, 14, 0.96);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 8px 0;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
        z-index: 60;
      }

      .js80-dropdown.is-open .js80-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0s;
      }

      .js80-menu-overview,
      .js80-menu-item {
        display: block;
        padding: 8px 16px;
        font-size: 0.8125rem;
        color: #b0b0b0;
        text-decoration: none;
        transition: color 0.15s ease, background-color 0.15s ease;
        letter-spacing: 0.01em;
      }

      .js80-menu-overview {
        font-weight: 500;
        color: #d8d8d8;
      }

      .js80-menu-overview:hover,
      .js80-menu-item:hover {
        color: #f0f0f0;
        background-color: rgba(255, 255, 255, 0.04);
      }

      .js80-menu-divider {
        height: 1px;
        background-color: rgba(255, 255, 255, 0.06);
        margin: 6px 12px;
      }

      .js80-menu-label {
        padding: 6px 16px 4px;
        font-size: 0.625rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #4a4a4a;
        font-weight: 500;
      }
    </style>

    <script>
      const toggle   = document.getElementById('nav-toggle');
      const menu     = document.getElementById('nav-mobile-menu');
      const iconOpen  = document.getElementById('nav-icon-open');
      const iconClose = document.getElementById('nav-icon-close');

      toggle?.addEventListener('click', () => {
        const isOpen = menu?.style.display !== 'none';
        if (menu)     menu.style.display     = isOpen ? 'none' : 'block';
        if (iconOpen)  iconOpen.style.display  = isOpen ? 'block' : 'none';
        if (iconClose) iconClose.style.display = isOpen ? 'none' : 'block';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.style.color = isOpen ? '#6b6b6b' : '#f0f0f0';
      });

      // Cerrar al hacer click en un link del menú
      menu?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (menu)     menu.style.display     = 'none';
          if (iconOpen)  iconOpen.style.display  = 'block';
          if (iconClose) iconClose.style.display = 'none';
          toggle?.setAttribute('aria-expanded', 'false');
          if (toggle) toggle.style.color = '#6b6b6b';
        });
      });

      // ── JS80 dropdown (desktop) ──
      const js80Dropdown = document.querySelector<HTMLElement>('[data-js80-dropdown]');
      const js80Trigger  = document.getElementById('js80-trigger');

      const closeJs80 = () => {
        js80Dropdown?.classList.remove('is-open');
        js80Trigger?.setAttribute('aria-expanded', 'false');
      };

      js80Trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = js80Dropdown?.classList.toggle('is-open') ?? false;
        js80Trigger.setAttribute('aria-expanded', String(isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!js80Dropdown?.classList.contains('is-open')) return;
        if (js80Dropdown.contains(e.target as Node)) return;
        closeJs80();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && js80Dropdown?.classList.contains('is-open')) {
          closeJs80();
          js80Trigger?.focus();
        }
      });
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/5 py-8 px-6">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-4 flex-wrap">

        <div style="display:flex; align-items:center; gap:1.25rem;">
          <span class="text-xs" style="color: #6b6b6b;">© {new Date().getFullYear()} Juan Segundo Barrio</span>
          <a href="https://www.linkedin.com/in/juansebarrio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style="color: #6b6b6b; display:flex; align-items:center; transition: color 0.2s;" onmouseover="this.style.color='#f0f0f0'" onmouseout="this.style.color='#6b6b6b'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:contacto@juansebarrio.com" aria-label="Enviar email" style="color: #6b6b6b; display:flex; align-items:center; transition: color 0.2s;" onmouseover="this.style.color='#f0f0f0'" onmouseout="this.style.color='#6b6b6b'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 7 10-7"/>
            </svg>
          </a>
        </div>

        <span class="text-xs" style="color: #4a4a4a; max-width: 32rem; text-align: right; line-height: 1.5;">
          Los casos bajo NDA son confidenciales. Su acceso implica aceptar no compartir ni reproducir el contenido.
        </span>

      </div>
    </footer>

    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>
