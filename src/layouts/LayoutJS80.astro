---
/**
 * Layout para páginas JS80 Studio dentro del portfolio de Juanse.
 * Override explícito del tema oscuro del portfolio (global.css usa @layer base
 * → cualquier regla sin layer tiene mayor especificidad y la pisa).
 */

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JS80 Studio',
  description = 'Estudio de soluciones digitales. De la idea al negocio funcionando.',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/') || currentPath === '/en';
const basePath = isEnglish ? (currentPath.replace(/^\/en/, '') || '/') : currentPath;
const switchPath = isEnglish
  ? basePath
  : (currentPath === '/' ? '/en' : '/en' + currentPath);
const backHref = isEnglish ? '/en' : '/';
---

<!doctype html>
<html lang="es" data-theme="js80">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- JS80 fonts: Fraunces (display) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ═══════════════════════════════════════════════════
         Override del tema oscuro del portfolio.
         Sin @layer → mayor especificidad que @layer base.
         Aplica solo cuando html tiene data-theme="js80".
         ═══════════════════════════════════════════════════ */

      html[data-theme="js80"] {
        background-color: #fafafa;
        color: #2c2c2a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      html[data-theme="js80"] body {
        background-color: #fafafa;
        color: #2c2c2a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        margin: 0;
        padding: 0;
      }

      /* Tipografías: headings → Fraunces, body → Inter */
      html[data-theme="js80"] h1,
      html[data-theme="js80"] h2,
      html[data-theme="js80"] h3,
      html[data-theme="js80"] h4,
      html[data-theme="js80"] h5,
      html[data-theme="js80"] h6 {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 500;
        margin: 0;
        color: #2c2c2a;
      }

      html[data-theme="js80"] p {
        margin: 0;
      }

      html[data-theme="js80"] a {
        color: inherit;
        text-decoration: none;
      }

      html[data-theme="js80"] img,
      html[data-theme="js80"] svg {
        display: block;
        max-width: 100%;
      }

      html[data-theme="js80"] *,
      html[data-theme="js80"] *::before,
      html[data-theme="js80"] *::after {
        box-sizing: border-box;
      }

      /* ── Variables de diseño JS80 ── */
      html[data-theme="js80"] {
        --c-blue:         #6B8CFF;
        --c-violet:       #8B6FFF;
        --c-turquoise:    #5DC7E0;
        --c-violet-light: #A67AFF;
        --c-coral:        #FF8AA0;
        --c-peach:        #FFB088;

        --text-primary:   #2c2c2a;
        --text-body:      #4a4a46;
        --text-secondary: #5a5a56;
        --text-meta:      #8a8a84;
        --text-ghost:     #a0a09a;

        --bg-main:        #fafafa;
        --bg-white:       #ffffff;
        --bg-dark:        #2c2c2a;

        --border-line:    #e8e8e3;
        --border-soft:    #efefea;

        --font-serif:     'Fraunces', Georgia, serif;
        --font-sans:      'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

        --radius-btn:     8px;
        --radius-card:    14px;
      }

      /* ── Utilities compartidas (usadas en el case study) ── */
      html[data-theme="js80"] .label {
        font-family: var(--font-sans);
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--text-ghost);
        font-weight: 500;
        display: block;
      }

      html[data-theme="js80"] .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      html[data-theme="js80"] .section {
        padding: 72px 64px;
        border-bottom: 0.5px solid var(--border-soft);
      }

      html[data-theme="js80"] .section-white {
        background: var(--bg-white);
      }

      html[data-theme="js80"] .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: var(--bg-dark);
        color: #ffffff;
        border-radius: var(--radius-btn);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.01em;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
      }

      html[data-theme="js80"] .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(44, 44, 42, 0.18);
        color: #ffffff;
      }

      html[data-theme="js80"] .btn-ghost {
        display: inline-block;
        padding: 8px 0;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        border-bottom: 1px solid currentColor;
        transition: opacity 0.2s ease;
        text-decoration: none;
      }

      html[data-theme="js80"] .btn-ghost:hover {
        opacity: 0.6;
      }

      @media (max-width: 900px) {
        html[data-theme="js80"] .section {
          padding: 56px 24px;
        }
      }
    </style>
  </head>

  <body>

    <!-- ── NAV JS80 ── -->
    <header class="js80-nav">
      <div class="js80-nav-inner">
        <a href={backHref} class="js80-nav-back">← Juanse Barrio</a>
        <a href={isEnglish ? '/en/js80' : '/js80'} class="js80-nav-logo">js80</a>
        <div style="display:flex; align-items:center; gap:1.5rem;">
          <a href={switchPath} class="js80-nav-back" style="border: 0.5px solid #e0ddd5; padding: 2px 8px; border-radius: 3px; font-size: 11px; letter-spacing: 0.1em;">
            {isEnglish ? 'ES' : 'EN'}
          </a>
          <a href="https://www.js80.studio" target="_blank" rel="noopener noreferrer" class="js80-nav-ext">
            js80.studio&nbsp;↗
          </a>
        </div>
      </div>
    </header>

    <!-- ── CONTENIDO ── -->
    <main>
      <slot />
    </main>

    <!-- ── FOOTER JS80 ── -->
    <footer class="js80-footer">
      <div class="js80-footer-inner">
        <span>© {new Date().getFullYear()} JS80 Studio</span>
        <a href="mailto:contacto@juansebarrio.com">contacto@juansebarrio.com</a>
      </div>
    </footer>

    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>

<style>
  /* ── NAV ── */
  .js80-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 0.5px solid #e8e8e3;
  }

  .js80-nav-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 64px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .js80-nav-back {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #a0a09a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .js80-nav-back:hover {
    color: #2c2c2a;
  }

  .js80-nav-logo {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: #2c2c2a;
    text-decoration: none;
    line-height: 1;
  }

  .js80-nav-ext {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #a0a09a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .js80-nav-ext:hover {
    color: #2c2c2a;
  }

  /* ── FOOTER ── */
  .js80-footer {
    background: #fafafa;
    border-top: 0.5px solid #e8e8e3;
    padding: 0 64px;
  }

  .js80-footer-inner {
    max-width: 1040px;
    margin: 0 auto;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    color: #a0a09a;
  }

  .js80-footer-inner a {
    color: #a0a09a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .js80-footer-inner a:hover {
    color: #2c2c2a;
  }

  @media (max-width: 900px) {
    .js80-nav-inner {
      padding: 0 24px;
    }

    .js80-footer {
      padding: 16px 24px;
      height: auto;
    }

    .js80-footer-inner {
      height: auto;
    }
  }
</style>
