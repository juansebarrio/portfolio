---
/**
 * Layout para páginas JS80 Studio dentro del portfolio de Juanse.
 * Override explícito del tema oscuro del portfolio (global.css usa @layer base
 * → cualquier regla sin layer tiene mayor especificidad y la pisa).
 */

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title = 'JS80 Studio',
  description = 'Estudio de soluciones digitales. De la idea al negocio funcionando.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en/') || currentPath === '/en';
const basePath = isEnglish ? (currentPath.replace(/^\/en/, '') || '/') : currentPath;
const switchPath = isEnglish
  ? basePath
  : (currentPath === '/' ? '/en' : '/en' + currentPath);
const backHref = isEnglish ? '/en' : '/';

const SITE = 'https://juansebarrio.com';
const canonicalUrl = new URL(currentPath, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
const esUrl = `${SITE}${basePath === '/' ? '' : basePath}`;
const enUrl = `${SITE}/en${basePath === '/' ? '' : basePath}`;

const segmentLabels: Record<string, { es: string; en: string }> = {
  js80: { es: 'JS80', en: 'JS80' },
};
const segments = basePath.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const pageTitle = title.split(' — ')[0].split(' · ')[0].trim();
const homeLabel = isEnglish ? 'Home' : 'Inicio';

const prefix = isEnglish ? '/en' : '';
const js80Href    = `${prefix}/js80`;
const aureHref     = 'https://aure-ebon.vercel.app/';
const leadsHref    = 'https://www.js80.studio/proyectos/leads-tablero/';
const cardioHref  = 'https://consulcardiologico.vercel.app/';
const hospitalHref = 'https://institucionalmultiple.js80.studio/';

const js80OverviewActive = basePath === '/js80';

const inmobiliariaHref = 'https://www.js80.studio/trabajo/inmobiliaria';
const vidrieraHref     = 'https://www.js80.studio/vidriera';

const N = isEnglish
  ? { studio: 'JS80 Studio', products: 'Custom Products', inmobiliaria: 'Real Estate Dashboard', leads: 'Leads Dashboard' }
  : { studio: 'Estudio JS80', products: 'Productos a medida', inmobiliaria: 'Tablero para Inmobiliaria', leads: 'Tablero de leads' };

const breadcrumbItems = segments.length > 0
  ? [
      { '@type': 'ListItem', position: 1, name: homeLabel, item: isEnglish ? `${SITE}/en` : SITE },
      ...segments.map((seg, idx) => {
        const isLast = idx === segments.length - 1;
        const url = `${SITE}${isEnglish ? '/en' : ''}/${segments.slice(0, idx + 1).join('/')}`;
        const known = segmentLabels[seg];
        const name = isLast ? pageTitle : (known ? known[isEnglish ? 'en' : 'es'] : seg);
        return { '@type': 'ListItem', position: idx + 2, name, item: url };
      }),
    ]
  : null;
---

<!doctype html>
<html lang={isEnglish ? 'en' : 'es'} data-theme="js80">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-AR" href={esUrl} />
    <link rel="alternate" hreflang="en-US" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="JS80 Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'es_AR'} />
    <meta property="og:locale:alternate" content={isEnglish ? 'es_AR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JS80 fonts: Fraunces (display) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    {breadcrumbItems && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbItems,
        })}
      />
    )}

    <slot name="head" />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-Eb0eVpXKn3crloCY9jzDQ.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <style is:global>
      /* ═══════════════════════════════════════════════════
         Override del tema oscuro del portfolio.
         Sin @layer → mayor especificidad que @layer base.
         Aplica solo cuando html tiene data-theme="js80".
         ═══════════════════════════════════════════════════ */

      html[data-theme="js80"] {
        background-color: #fafafa;
        color: #2c2c2a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      html[data-theme="js80"] body {
        background-color: #fafafa;
        color: #2c2c2a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        margin: 0;
        padding: 0;
      }

      /* Tipografías: headings → Fraunces, body → Inter */
      html[data-theme="js80"] h1,
      html[data-theme="js80"] h2,
      html[data-theme="js80"] h3,
      html[data-theme="js80"] h4,
      html[data-theme="js80"] h5,
      html[data-theme="js80"] h6 {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 500;
        margin: 0;
        color: #2c2c2a;
      }

      html[data-theme="js80"] p {
        margin: 0;
      }

      html[data-theme="js80"] a {
        color: inherit;
        text-decoration: none;
      }

      html[data-theme="js80"] img,
      html[data-theme="js80"] svg {
        display: block;
        max-width: 100%;
      }

      html[data-theme="js80"] *,
      html[data-theme="js80"] *::before,
      html[data-theme="js80"] *::after {
        box-sizing: border-box;
      }

      /* ── Variables de diseño JS80 ── */
      html[data-theme="js80"] {
        --c-blue:         #6B8CFF;
        --c-violet:       #8B6FFF;
        --c-turquoise:    #5DC7E0;
        --c-violet-light: #A67AFF;
        --c-coral:        #FF8AA0;
        --c-peach:        #FFB088;

        --text-primary:   #2c2c2a;
        --text-body:      #4a4a46;
        --text-secondary: #5a5a56;
        --text-meta:      #8a8a84;
        --text-ghost:     #a0a09a;

        --bg-main:        #fafafa;
        --bg-white:       #ffffff;
        --bg-dark:        #2c2c2a;

        --border-line:    #e8e8e3;
        --border-soft:    #efefea;

        --font-serif:     'Fraunces', Georgia, serif;
        --font-sans:      'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

        --radius-btn:     8px;
        --radius-card:    14px;
      }

      /* ── Utilities compartidas (usadas en el case study) ── */
      html[data-theme="js80"] .label {
        font-family: var(--font-sans);
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--text-ghost);
        font-weight: 500;
        display: block;
      }

      html[data-theme="js80"] .container {
        max-width: 1040px;
        margin: 0 auto;
      }

      html[data-theme="js80"] .section {
        padding: 72px 64px;
        border-bottom: 0.5px solid var(--border-soft);
      }

      html[data-theme="js80"] .section-white {
        background: var(--bg-white);
      }

      html[data-theme="js80"] .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: var(--bg-dark);
        color: #ffffff;
        border-radius: var(--radius-btn);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.01em;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
      }

      html[data-theme="js80"] .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(44, 44, 42, 0.18);
        color: #ffffff;
      }

      html[data-theme="js80"] .btn-ghost {
        display: inline-block;
        padding: 8px 0;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        border-bottom: 1px solid currentColor;
        transition: opacity 0.2s ease;
        text-decoration: none;
      }

      html[data-theme="js80"] .btn-ghost:hover {
        opacity: 0.6;
      }

      @media (max-width: 900px) {
        html[data-theme="js80"] .section {
          padding: 56px 24px;
        }
      }
    </style>
  </head>

  <body>

    <!-- ── NAV JS80 ── -->
    <header class="js80-nav">
      <div class="js80-nav-inner">
        <a href={backHref} class="js80-nav-back">← Juanse Barrio</a>

        <div class="js80-products-dropdown" data-js80-products>
          <button
            type="button"
            id="js80-products-trigger"
            class="js80-nav-logo js80-products-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="js80-products-menu"
          >
            js80
            <svg class="js80-products-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            id="js80-products-menu"
            class="js80-products-menu"
            role="menu"
            aria-labelledby="js80-products-trigger"
          >
            <a
              href={js80Href}
              role="menuitem"
              class="js80-products-overview"
              style={js80OverviewActive ? 'color: #2c2c2a;' : ''}
            >
              {N.studio}
            </a>
            <div class="js80-products-divider"></div>
            <div class="js80-products-label">{N.products}</div>
            <a
              href={aureHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext js80-products-item-featured"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="js80-products-featured-name">
                <span class="js80-products-featured-dot" aria-hidden="true"></span>
                AURE Real Estate
              </span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
            <a
              href={leadsHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{N.leads}</span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
            <a
              href={vidrieraHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>VidrierAI</span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
            <a
              href={cardioHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Cardiología B·S</span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
            <a
              href={hospitalHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Hospital Aranda</span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
            <a
              href={inmobiliariaHref}
              role="menuitem"
              class="js80-products-item js80-products-item-ext"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{N.inmobiliaria}</span>
              <span class="js80-products-ext" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div style="display:flex; align-items:center; gap:1.5rem;">
          <a href={switchPath} class="js80-nav-back" style="border: 0.5px solid #e0ddd5; padding: 2px 8px; border-radius: 3px; font-size: 11px; letter-spacing: 0.1em;">
            {isEnglish ? 'ES' : 'EN'}
          </a>
          <a href="https://www.js80.studio" target="_blank" rel="noopener noreferrer" class="js80-nav-ext">
            js80.studio&nbsp;↗
          </a>
        </div>
      </div>
    </header>

    <!-- ── CONTENIDO ── -->
    <main>
      <slot />
    </main>

    <!-- ── FOOTER JS80 ── -->
    <footer class="js80-footer">
      <div class="js80-footer-inner">
        <span>© {new Date().getFullYear()} JS80 Studio</span>
        <a href="mailto:contacto@juansebarrio.com">contacto@juansebarrio.com</a>
      </div>
    </footer>

    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();

      // ── JS80 products dropdown ──
      const productsDropdown = document.querySelector<HTMLElement>('[data-js80-products]');
      const productsTrigger  = document.getElementById('js80-products-trigger');

      const closeProducts = () => {
        productsDropdown?.classList.remove('is-open');
        productsTrigger?.setAttribute('aria-expanded', 'false');
      };

      productsTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = productsDropdown?.classList.toggle('is-open') ?? false;
        productsTrigger.setAttribute('aria-expanded', String(isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!productsDropdown?.classList.contains('is-open')) return;
        if (productsDropdown.contains(e.target as Node)) return;
        closeProducts();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && productsDropdown?.classList.contains('is-open')) {
          closeProducts();
          productsTrigger?.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  /* ── NAV ── */
  .js80-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 0.5px solid #e8e8e3;
  }

  .js80-nav-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 64px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .js80-nav-back {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #a0a09a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .js80-nav-back:hover {
    color: #2c2c2a;
  }

  .js80-nav-logo {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: #2c2c2a;
    text-decoration: none;
    line-height: 1;
  }

  /* ── Productos dropdown ── */
  .js80-products-dropdown {
    position: relative;
  }

  .js80-products-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: #2c2c2a;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.15s ease;
  }

  .js80-products-trigger:hover {
    opacity: 0.7;
  }

  .js80-products-chevron {
    color: #a0a09a;
    transition: transform 0.2s ease, color 0.2s ease;
    margin-top: 4px;
  }

  .js80-products-dropdown.is-open .js80-products-chevron {
    transform: rotate(180deg);
    color: #2c2c2a;
  }

  .js80-products-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    min-width: 240px;
    background: #ffffff;
    border: 0.5px solid #e8e8e3;
    border-radius: 10px;
    padding: 8px 0;
    box-shadow: 0 16px 40px rgba(44, 44, 42, 0.10);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
    z-index: 120;
  }

  .js80-products-dropdown.is-open .js80-products-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0s;
  }

  .js80-products-overview,
  .js80-products-item {
    display: block;
    padding: 9px 18px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    color: #5a5a56;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .js80-products-overview {
    font-weight: 500;
    color: #2c2c2a;
  }

  .js80-products-overview:hover,
  .js80-products-item:hover {
    color: #2c2c2a;
    background-color: #f5f3ee;
  }

  .js80-products-item-ext {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .js80-products-ext {
    font-size: 11px;
    color: #a0a09a;
    transition: color 0.15s ease;
  }

  .js80-products-item-ext:hover .js80-products-ext {
    color: #2c2c2a;
  }

  .js80-products-item-featured {
    color: #2c2c2a;
    font-weight: 600;
  }

  .js80-products-featured-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .js80-products-featured-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #6B8CFF, #8B6FFF);
    flex-shrink: 0;
  }

  .js80-products-divider {
    height: 1px;
    background: #efefea;
    margin: 6px 14px;
  }

  .js80-products-label {
    padding: 6px 18px 4px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a0a09a;
    font-weight: 500;
  }

  .js80-nav-ext {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #a0a09a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .js80-nav-ext:hover {
    color: #2c2c2a;
  }

  /* ── FOOTER ── */
  .js80-footer {
    background: #fafafa;
    border-top: 0.5px solid #e8e8e3;
    padding: 0 64px;
  }

  .js80-footer-inner {
    max-width: 1040px;
    margin: 0 auto;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    color: #a0a09a;
  }

  .js80-footer-inner a {
    color: #a0a09a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .js80-footer-inner a:hover {
    color: #2c2c2a;
  }

  @media (max-width: 900px) {
    .js80-nav-inner {
      padding: 0 24px;
    }

    .js80-footer {
      padding: 16px 24px;
      height: auto;
    }

    .js80-footer-inner {
      height: auto;
    }
  }
</style>
