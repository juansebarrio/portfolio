---
interface Props {
  redirectTo?: string;
  autoShow?: boolean;
}
const { redirectTo = '', autoShow = false } = Astro.props;
---

<div id="password-gate" role="dialog" aria-modal="true" aria-label="Portfolio protegido">
  <div class="gate-modal">
    <h2 class="gate-title">Casos bajo NDA</h2>
    <p class="gate-subtitle">Estos casos contienen información confidencial de Banco Galicia. Ingresá la contraseña para acceder.</p>
    <form id="gate-form" novalidate>
      <input
        type="password"
        id="gate-input"
        class="gate-input"
        placeholder="Contraseña"
        autocomplete="current-password"
      />
      <p id="gate-error" class="gate-error" hidden>Contraseña incorrecta. Intentá de nuevo.</p>
      <button type="submit" class="gate-btn">Acceder</button>
    </form>
  </div>
</div>

<script define:vars={{ initialRedirectTo: redirectTo, autoShow }}>
  const STORAGE_KEY = 'portfolio-auth';
  const PASSWORD = 'libertador123456';

  const gate = document.getElementById('password-gate');
  const form = document.getElementById('gate-form');
  const input = document.getElementById('gate-input');
  const errorEl = document.getElementById('gate-error');

  function showGate() {
    gate.style.display = 'flex';
    setTimeout(() => input?.focus(), 100);
  }

  function hideGate() {
    gate.style.display = 'none';
  }

  function doAuth(target) {
    sessionStorage.setItem(STORAGE_KEY, 'true');
    const dest = target || window.__gateTarget || initialRedirectTo;
    if (dest) {
      window.location.href = dest;
    } else {
      hideGate();
      window.dispatchEvent(new CustomEvent('portfolio-auth'));
    }
  }

  // Global API for external callers
  window.__showPasswordGate = function(targetUrl) {
    window.__gateTarget = targetUrl || null;
    showGate();
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input.value === PASSWORD) {
      errorEl.hidden = true;
      doAuth(null);
    } else {
      errorEl.hidden = false;
      input.value = '';
      input.focus();
    }
  });

  // Close on backdrop click
  gate.addEventListener('click', (e) => {
    if (e.target === gate) hideGate();
  });

  gate.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideGate();
  });

  if (autoShow && sessionStorage.getItem(STORAGE_KEY) !== 'true') {
    showGate();
  }
</script>

<style>
  #password-gate {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(12px);
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .gate-modal {
    width: 100%;
    max-width: 24rem;
    padding: 2.5rem;
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
  }

  .gate-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #f0f0f0;
    margin: 0 0 0.875rem;
  }

  .gate-subtitle {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.9375rem;
    color: #a0a0a0;
    line-height: 1.5;
    margin: 0 0 2rem;
  }

  #gate-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gate-input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    color: #f0f0f0;
    font-size: 1rem;
    font-family: system-ui, -apple-system, sans-serif;
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .gate-input:focus {
    border-color: #ff6b3d;
  }

  .gate-error {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.8125rem;
    color: #ff4444;
    margin: 0;
  }

  .gate-btn {
    width: 100%;
    padding: 0.875rem;
    background: #ff6b3d;
    color: #0a0a0a;
    border: none;
    border-radius: 8px;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .gate-btn:hover {
    background: #ff8560;
  }
</style>
