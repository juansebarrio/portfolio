---
/**
 * Escena 4 — Las etapas de un desarrollo.
 *
 * El eje del negocio de AURE es la compra en pozo, y lo que angustia al que
 * compra en pozo es no saber en qué punto está. La escena dibuja el recorrido
 * completo y ancla los dos desarrollos de la cartera en su etapa real.
 */
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const t =
  lang === 'en'
    ? {
        eyebrow: 'Stages · Off-plan purchase',
        caption: 'The stage rail, with each development pinned to where it actually is',
        alt: 'Rail with the stages of an off-plan purchase, from booking to deed, with two developments pinned to their stage.',
        steps: ['Booking', 'Deed of sale', 'Construction', 'Handover', 'Title deed'],
        pins: [
          { at: 2, name: 'Vuelta de Obligado 3830', state: 'Under construction', dev: 'CDO hub' },
          { at: 4, name: 'Nogoyá 2478', state: 'Ready to deed', dev: 'Nocito Constructora' },
        ],
        devBy: 'Developed by',
      }
    : {
        eyebrow: 'Etapas · Compra en pozo',
        caption: 'El riel de etapas, con cada desarrollo anclado donde está de verdad',
        alt: 'Riel con las etapas de una compra en pozo, de la reserva a la escritura, con dos desarrollos anclados en su etapa.',
        steps: ['Reserva', 'Boleto', 'Obra', 'Entrega', 'Escritura'],
        pins: [
          { at: 2, name: 'Vuelta de Obligado 3830', state: 'En desarrollo', dev: 'CDO hub' },
          { at: 4, name: 'Nogoyá 2478', state: 'Listo para escriturar', dev: 'Nocito Constructora' },
        ],
        devBy: 'Desarrolla',
      };

const N = t.steps.length;
/* Cada nodo queda en el centro de su tramo: 0.5/N, 1.5/N, … */
const posOf = (i: number) => ((i + 0.5) / N) * 100;
---

<figure class="aure-stage" data-aure-scene>
  <div class="aure-panel et-panel">
    <p class="sr-only">{t.alt}</p>

    <p class="aure-eyebrow aure-in" style="--d:0ms">{t.eyebrow}</p>

    <div class="et-rail" aria-hidden="true">
      {/* Los dos desarrollos, colgando arriba de su etapa */}
      <div class="et-pins">
        {
          t.pins.map((p, i) => (
            <div class="et-pin" style={`left:${posOf(p.at)}%; --d:${1500 + i * 320}ms`}>
              <div class="et-pin-card">
                <p class="et-pin-state">{p.state}</p>
                <p class="et-pin-name">{p.name}</p>
                <p class="et-pin-dev">
                  {t.devBy} · {p.dev}
                </p>
              </div>
              <span class="et-pin-stem"></span>
            </div>
          ))
        }
      </div>

      {/* El riel: una línea apagada y encima la dorada que se dibuja */}
      <div class="et-line">
        <span class="et-line-fill"></span>
        {
          t.steps.map((_, i) => (
            <span class="et-node" style={`left:${posOf(i)}%; --d:${420 + i * 200}ms`} />
          ))
        }
      </div>

      <div class="et-labels">
        {
          t.steps.map((s, i) => (
            <span class="et-label" style={`left:${posOf(i)}%; --d:${520 + i * 200}ms`}>
              {s}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <figcaption class="aure-caption">{t.caption}</figcaption>
</figure>

<style>
  .et-panel {
    padding: clamp(26px, 4vw, 44px);
  }

  .et-rail {
    position: relative;
    margin-top: clamp(96px, 13vw, 128px);
    padding-bottom: 34px;
  }

  /* ── Riel ── */
  .et-line {
    position: relative;
    height: 1px;
    background: color-mix(in oklab, var(--aure-blanco) 14%, transparent);
  }

  .et-line-fill {
    position: absolute;
    inset: 0;
    background: var(--aure-dorado);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1900ms var(--aure-ease) 320ms;
  }

  .is-playing .et-line-fill {
    transform: scaleX(1);
  }

  .et-node {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--aure-profundo);
    border: 1px solid color-mix(in oklab, var(--aure-blanco) 22%, transparent);
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 620ms var(--aure-ease),
      opacity 620ms var(--aure-ease),
      border-color 620ms var(--aure-ease),
      background-color 620ms var(--aure-ease);
    transition-delay: var(--d, 0ms);
  }

  .is-playing .et-node {
    transform: scale(1);
    opacity: 1;
    background: var(--aure-dorado);
    border-color: var(--aure-dorado);
  }

  /* ── Etiquetas ── */
  .et-labels {
    position: relative;
    height: 24px;
  }

  .et-label {
    position: absolute;
    top: 14px;
    transform: translate(-50%, 8px);
    white-space: nowrap;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--aure-blanco) 55%, transparent);
    opacity: 0;
    transition:
      opacity 700ms var(--aure-ease),
      transform 700ms var(--aure-ease);
    transition-delay: var(--d, 0ms);
  }

  .is-playing .et-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ── Desarrollos anclados ── */
  .et-pins {
    position: absolute;
    inset: auto 0 100% 0;
    height: 0;
  }

  .et-pin {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .et-pin-card {
    width: max-content;
    max-width: 210px;
    padding: 10px 13px;
    border: 1px solid color-mix(in oklab, var(--aure-dorado) 28%, transparent);
    border-radius: 8px;
    background: color-mix(in oklab, var(--aure-profundo) 88%, transparent);
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 760ms var(--aure-ease),
      transform 760ms var(--aure-ease);
    transition-delay: var(--d, 0ms);
  }

  .is-playing .et-pin-card {
    opacity: 1;
    transform: none;
  }

  .et-pin-state {
    margin: 0;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aure-dorado);
  }

  .et-pin-name {
    margin: 5px 0 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--aure-blanco);
    line-height: 1.25;
  }

  .et-pin-dev {
    margin: 4px 0 0;
    font-size: 10px;
    color: color-mix(in oklab, var(--aure-gris) 70%, transparent);
  }

  /* El hilo que baja de la ficha al nodo */
  .et-pin-stem {
    display: block;
    width: 1px;
    height: 22px;
    background: color-mix(in oklab, var(--aure-dorado) 40%, transparent);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 520ms var(--aure-ease);
    transition-delay: calc(var(--d, 0ms) + 300ms);
  }

  .is-playing .et-pin-stem {
    transform: scaleY(1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* En pantallas chicas las dos fichas ancladas no entran una al lado de
     la otra: se pisan entre sí y se salen del panel. Bajan a una lista
     debajo del riel, que sigue mostrando el recorrido completo. */
  @media (max-width: 760px) {
    .et-rail {
      margin-top: 26px;
      padding-bottom: 0;
    }

    .et-label {
      font-size: 8px;
      letter-spacing: 0.02em;
    }

    .et-pins {
      position: static;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 30px;
      order: 2;
    }

    .et-pin {
      position: static;
      /* el left en % viene inline, para la versión anclada */
      left: auto !important;
      transform: none;
      align-items: stretch;
    }

    .et-pin-card {
      max-width: none;
      width: 100%;
      padding: 10px 12px;
      text-align: left;
    }

    .et-pin-name {
      font-size: 12px;
    }

    .et-pin-stem {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .et-node,
    .et-label,
    .et-pin-card {
      opacity: 1 !important;
      transition: none !important;
    }

    .et-node {
      transform: scale(1);
      background: var(--aure-dorado);
      border-color: var(--aure-dorado);
    }

    .et-label {
      transform: translate(-50%, 0);
    }

    .et-pin-card {
      transform: none;
    }

    .et-line-fill,
    .et-pin-stem {
      transform: none;
      transition: none;
    }
  }
</style>
