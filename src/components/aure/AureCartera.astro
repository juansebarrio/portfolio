---
/**
 * Escena 3 — La cartera en movimiento.
 *
 * Dos filas de fichas que derivan en sentidos opuestos, lento. Es el gesto
 * clásico de una web inmobiliaria de gama alta: la cartera no se explora,
 * desfila. Se frena al pasar el mouse o al enfocar con el teclado.
 *
 * Las propiedades son las publicadas hoy en aure.ar (origen: Tokko).
 */
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const t =
  lang === 'en'
    ? {
        eyebrow: 'Portfolio · Sales and rentals',
        sale: 'Sale',
        rent: 'Rent',
        hint: 'Hover to pause',
        caption: 'The listing strip: two rows drifting in opposite directions',
        alt: 'Two rows of property cards drifting slowly in opposite directions.',
        month: '/mo',
      }
    : {
        eyebrow: 'Portafolio · Ventas y alquileres',
        sale: 'Venta',
        rent: 'Alquiler',
        hint: 'Pasá el mouse para frenar',
        caption: 'La tira de cartera: dos filas que derivan en sentidos opuestos',
        alt: 'Dos filas de fichas de propiedades que derivan lentamente en sentidos opuestos.',
        month: '/mes',
      };

type Item = { zona: string; op: 'sale' | 'rent'; precio: string; meta: string };

/* Fila superior: venta. Fila inferior: mezcla de venta y alquiler. */
const ROW_A: Item[] = [
  { zona: 'Recoleta', op: 'sale', precio: 'USD 390.000', meta: '3 amb · 85 m²' },
  { zona: 'Parque Chas', op: 'sale', precio: 'USD 169.000', meta: '3 amb · 75,75 m²' },
  { zona: 'Villa Gesell', op: 'sale', precio: 'USD 140.000', meta: '3 amb · 90 m²' },
  { zona: 'Pinamar', op: 'sale', precio: 'USD 190.000', meta: '3 amb · 93 m²' },
  { zona: 'Flores', op: 'sale', precio: 'USD 106.000', meta: '3 amb · 58 m²' },
];

const ROW_B: Item[] = [
  { zona: 'Centro Playa', op: 'sale', precio: 'USD 139.000', meta: '3 amb · 61 m²' },
  { zona: 'Palermo', op: 'rent', precio: '$ 800.000', meta: '1 amb · 51 m²' },
  { zona: 'Villa Crespo', op: 'rent', precio: '$ 1.250.000', meta: '2 amb · 55,9 m²' },
  { zona: 'Villa Gesell', op: 'sale', precio: 'USD 95.000', meta: '2 amb · 66 m²' },
  { zona: 'Villa Gesell', op: 'sale', precio: 'USD 69.000', meta: '2 amb · 56 m²' },
];

/* La tira se duplica: el keyframe corre -50% y vuelve a cero sin salto. */
const loop = (items: Item[]) => [...items, ...items];
---

<figure class="aure-stage" data-aure-scene>
  <div class="aure-panel ct-panel">
    <p class="sr-only">{t.alt}</p>

    <div class="ct-head">
      <p class="aure-eyebrow aure-in" style="--d:0ms">{t.eyebrow}</p>
      <p class="ct-hint aure-in" style="--d:140ms" aria-hidden="true">{t.hint}</p>
    </div>

    <div class="ct-rows" aria-hidden="true">
      {
        [
          { items: loop(ROW_A), dir: 'a', d: 220 },
          { items: loop(ROW_B), dir: 'b', d: 380 },
        ].map((row) => (
          <div class="ct-row aure-in" style={`--d:${row.d}ms`}>
            <div class:list={['ct-track', `ct-track-${row.dir}`]}>
              {row.items.map((p) => (
                <article class="ct-card">
                  <div class:list={['ct-photo', `ct-photo-${p.op}`]}>
                    <span class="ct-badge">{p.op === 'sale' ? t.sale : t.rent}</span>
                  </div>
                  <div class="ct-body">
                    <p class="ct-zona">{p.zona}</p>
                    <p class="ct-precio">
                      {p.precio}
                      {p.op === 'rent' && <span class="ct-mes">{t.month}</span>}
                    </p>
                    <p class="ct-meta">{p.meta}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption class="aure-caption">{t.caption}</figcaption>
</figure>

<style>
  .ct-panel {
    padding: clamp(26px, 4vw, 44px) 0;
  }

  .ct-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(26px, 4vw, 44px);
    margin-bottom: clamp(20px, 3vw, 30px);
  }

  .ct-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--aure-blanco) 34%, transparent);
  }

  .ct-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    /* Las tiras se desvanecen contra los bordes: nada entra ni sale de golpe */
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .ct-row {
    overflow: hidden;
  }

  .ct-track {
    display: flex;
    gap: 14px;
    width: max-content;
    will-change: transform;
  }

  /* La deriva solo arranca cuando la escena está en pantalla */
  .is-playing .ct-track-a {
    animation: ct-left 64s linear infinite;
  }

  .is-playing .ct-track-b {
    animation: ct-right 78s linear infinite;
  }

  @keyframes ct-left {
    /* La mitad exacta: como la tira está duplicada, el corte es invisible.
       El gap del flex entra en la cuenta, de ahí el -7px. */
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - 7px)); }
  }

  @keyframes ct-right {
    from { transform: translateX(calc(-50% - 7px)); }
    to   { transform: translateX(0); }
  }

  .ct-rows:hover .ct-track,
  .ct-rows:focus-within .ct-track {
    animation-play-state: paused;
  }

  /* ── Ficha ── */
  .ct-card {
    flex: 0 0 auto;
    width: clamp(178px, 21vw, 226px);
    border: 1px solid color-mix(in oklab, var(--aure-blanco) 10%, transparent);
    border-radius: 10px;
    overflow: hidden;
    background: color-mix(in oklab, var(--aure-profundo) 62%, transparent);
    transition: border-color 400ms var(--aure-ease);
  }

  .ct-card:hover {
    border-color: color-mix(in oklab, var(--aure-dorado) 45%, transparent);
  }

  .ct-photo {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  /* Sin fotos reales: dos degradados de marca que diferencian operación */
  .ct-photo-sale {
    background:
      linear-gradient(155deg,
        color-mix(in oklab, var(--aure-azul) 70%, var(--aure-gris)) 0%,
        color-mix(in oklab, var(--aure-profundo) 88%, var(--aure-gris)) 100%);
  }

  .ct-photo-rent {
    background:
      linear-gradient(155deg,
        color-mix(in oklab, var(--aure-dorado) 28%, var(--aure-profundo)) 0%,
        color-mix(in oklab, var(--aure-profundo) 92%, var(--aure-gris)) 100%);
  }

  /* Hairlines: la insinuación de una fachada, no una foto falsa */
  .ct-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      color-mix(in oklab, var(--aure-blanco) 7%, transparent) 0 1px,
      transparent 1px 22px
    );
  }

  .ct-badge {
    position: absolute;
    z-index: 1;
    left: 8px;
    top: 8px;
    padding: 3px 7px;
    border-radius: var(--aure-radio);
    background: color-mix(in oklab, var(--aure-blanco) 92%, transparent);
    color: var(--aure-azul);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ct-body {
    padding: 11px 12px 13px;
  }

  .ct-zona {
    margin: 0;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--aure-dorado);
  }

  .ct-precio {
    margin: 6px 0 0;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--aure-blanco);
    font-variant-numeric: tabular-nums;
  }

  .ct-mes {
    font-size: 11px;
    font-weight: 400;
    color: color-mix(in oklab, var(--aure-blanco) 45%, transparent);
  }

  .ct-meta {
    margin: 3px 0 0;
    font-size: 11px;
    color: color-mix(in oklab, var(--aure-gris) 78%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Sin deriva: queda una tira estática que se puede recorrer a mano */
    .ct-track {
      animation: none !important;
    }

    .ct-row {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .ct-row::-webkit-scrollbar {
      display: none;
    }
  }
</style>
