---
interface Props {
  agentId?    : string;
  sectionId?  : string;
  eyebrow?    : string;
  heading?    : string;
  sub?        : string;
  idle?       : string;
  connecting? : string;
  listening?  : string;
  speaking?   : string;
  error?      : string;
  end?        : string;
  compact?    : boolean;
  ctaLabel?   : string;
  ctaHref?    : string;
}

const {
  agentId    = 'agent_3901kqb924nye4895n6khgp2c0sd',
  sectionId  = 'asistente',
  eyebrow    = 'Asistente JS80',
  heading    = 'Preguntá lo que quieras.',
  sub        = 'Nuestro asistente te cuenta qué hacemos, cómo trabajamos y si tiene sentido avanzar.',
  idle       = 'Tocá para hablar',
  connecting = 'Conectando…',
  listening  = 'Escuchando…',
  speaking   = 'Respondiendo…',
  error      = 'Algo salió mal. Intentá de nuevo.',
  end        = 'Terminar conversación',
  compact    = false,
  ctaLabel,
  ctaHref,
} = Astro.props;

const ui = { eyebrow, heading, sub, idle, connecting, listening, speaking, error, end };
const AGENT_ID = agentId;
const showCta  = !!(ctaLabel && ctaHref);
---

<section
  class="voice-section"
  id={sectionId}
  data-state="idle"
  data-compact={compact ? 'true' : 'false'}
  data-idle={ui.idle}
  data-connecting={ui.connecting}
  data-listening={ui.listening}
  data-speaking={ui.speaking}
  data-error={ui.error}
  data-agent={AGENT_ID}
>
  <div class="vs-inner">

    <div class="vs-intro">
      <span class="label vs-eyebrow">{ui.eyebrow}</span>
      <h2 class="serif vs-heading">{ui.heading}</h2>
      <p class="vs-sub">{ui.sub}</p>
      {showCta && (
        <a class="vs-cta" href={ctaHref} target="_blank" rel="noopener noreferrer">{ctaLabel}</a>
      )}
    </div>

    <div class="vs-orb-col">
      <div class="orb-scene">
        <div class="ring ring-3"></div>
        <div class="ring ring-2"></div>
        <div class="ring ring-1"></div>
        <div class="orb-scaler">
          <button class="orb" id="vs-orb-btn" aria-label={ui.idle}></button>
        </div>
      </div>

      <div class="vs-status-area">
        <div class="idle-hint" id="vs-idle-hint">
          <span class="idle-arrow">↑</span>
          <p class="idle-label">{ui.idle}</p>
        </div>
        <p class="vs-status" id="vs-status-text"></p>
        <button class="vs-end-btn" id="vs-end-btn" hidden>{ui.end}</button>
      </div>
    </div>

  </div>
</section>

<script>
  // @11labs/client pesa ~500 KB: se importa recién al click del orbe
  // para no cargarlo en el critical path de las páginas que lo incluyen.
  type ElevenLabs = typeof import('@11labs/client');

  type State = 'idle' | 'connecting' | 'listening' | 'speaking' | 'error';

  document.querySelectorAll<HTMLElement>('.voice-section').forEach((section) => {
    const orbBtn   = section.querySelector<HTMLButtonElement>('.orb')!;
    const endBtn   = section.querySelector<HTMLButtonElement>('.vs-end-btn')!;
    const statusEl = section.querySelector<HTMLElement>('.vs-status')!;
    const idleHint = section.querySelector<HTMLElement>('.idle-hint')!;
    const AGENT_ID = section.dataset.agent!;

    let convo: Awaited<ReturnType<ElevenLabs['Conversation']['startSession']>> | null = null;

    const getLabel = (state: State): string =>
      (section.dataset as Record<string, string>)[state] ?? '';

    function setState(state: State) {
      section.dataset.state = state;
      statusEl.textContent  = state === 'idle' ? '' : getLabel(state);
      idleHint.hidden       = state !== 'idle';
      endBtn.hidden         = state === 'idle' || state === 'error';
      orbBtn.disabled       = state === 'connecting';
    }

    orbBtn.addEventListener('click', async () => {
      const s = section.dataset.state as State;
      if (s !== 'idle' && s !== 'error') return;
      try {
        setState('connecting');
        const { Conversation } = await import('@11labs/client');
        convo = await Conversation.startSession({
          agentId     : AGENT_ID,
          onConnect   : ()         => setState('listening'),
          onDisconnect: ()         => { convo = null; setState('idle'); },
          onError     : ()         => setState('error'),
          onModeChange: ({ mode }) => setState(mode === 'speaking' ? 'speaking' : 'listening'),
        });
      } catch (e) {
        console.error(e);
        setState('error');
      }
    });

    endBtn.addEventListener('click', async () => {
      if (convo) { await convo.endSession(); convo = null; }
      setState('idle');
    });
  });
</script>

<style>
  .voice-section {
    background: var(--bg);
    padding: 96px 64px;
  }

  .vs-inner {
    max-width: 1040px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
  }

  /* Wrapper transparente: en modo default no afecta el layout vertical */
  .vs-orb-col { display: contents; }

  .vs-intro { text-align: center; }

  .vs-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 24px;
    padding: 12px 22px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .vs-cta:hover {
    background-color: var(--surface);
    border-color: var(--fg);
  }

  .vs-eyebrow {
    color: var(--muted);
    display: block;
    margin-bottom: 16px;
  }

  .vs-heading {
    font-size: 48px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: var(--fg);
    margin: 0 0 16px;
  }

  .vs-sub {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.65;
    max-width: 460px;
    margin: 0 auto;
  }

  .orb-scene {
    position: relative;
    width: 320px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-scaler {
    position: relative;
    z-index: 2;
    animation: orb-breathe 5s ease-in-out infinite;
  }

  .orb {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    outline: none;
    display: block;
    background:
      radial-gradient(circle at 30% 28%, rgba(255,255,255,0.5), transparent 38%),
      conic-gradient(
        from 180deg,
        var(--c-blue, #6B8CFF),
        var(--c-violet, #8B6FFF),
        var(--c-coral, #FF8AA0),
        var(--c-peach, #FFB088),
        var(--c-violet-light, #A67AFF),
        var(--c-turquoise, #5DC7E0),
        var(--c-blue, #6B8CFF)
      );
    box-shadow:
      0 0 0 1px rgba(107,140,255,0.35),
      0 0 0 14px rgba(107,140,255,0.1),
      0 0 0 15px rgba(107,140,255,0.22),
      0 0 50px rgba(107,140,255,0.25),
      0 0 100px rgba(139,111,255,0.15);
    animation: orb-rotate 60s linear infinite;
    transition: box-shadow 0.6s ease, filter 0.5s ease;
  }

  .orb:hover { filter: brightness(1.1); }
  .orb:disabled { cursor: default; }

  .ring {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 1px solid rgba(107,140,255,0.5);
    opacity: 0;
    z-index: 1;
  }

  @keyframes orb-rotate    { from { transform: rotate(0deg); }   to { transform: rotate(360deg); } }
  @keyframes orb-breathe   { 0%,100% { transform: scale(1); }    50% { transform: scale(1.04); } }
  @keyframes ring-sonar    { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(2.1); opacity: 0; } }
  @keyframes ring-speak    { 0% { transform: scale(1); opacity: 0.6; }  100% { transform: scale(1.6); opacity: 0; } }
  @keyframes orb-connect   { 0%,100% { opacity: 0.7; } 50% { opacity: 1; } }
  @keyframes orb-speak-pulse { 0%,100% { transform: scale(1); } 25% { transform: scale(1.05); } 60% { transform: scale(0.97); } }
  @keyframes arrow-bounce  { 0%,100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(-6px); opacity: 1; } }

  /* — connecting — */
  [data-state="connecting"] .orb {
    animation: orb-rotate 7s linear infinite, orb-connect 1.2s ease-in-out infinite;
    filter: brightness(0.85);
  }

  /* — listening — */
  [data-state="listening"] .orb {
    animation: orb-rotate 22s linear infinite;
    box-shadow:
      0 0 0 1px rgba(107,140,255,0.4),
      0 0 0 14px rgba(107,140,255,0.12),
      0 0 0 15px rgba(107,140,255,0.25),
      0 0 60px rgba(107,140,255,0.35),
      0 0 110px rgba(139,111,255,0.2);
  }
  [data-state="listening"] .orb-scaler { animation: none; }
  [data-state="listening"] .ring-1 { animation: ring-sonar 2s ease-out infinite 0s; }
  [data-state="listening"] .ring-2 { animation: ring-sonar 2s ease-out infinite 0.65s; }
  [data-state="listening"] .ring-3 { animation: ring-sonar 2s ease-out infinite 1.3s; }

  /* — speaking — */
  [data-state="speaking"] .orb {
    animation: orb-rotate 18s linear infinite;
    box-shadow:
      0 0 0 1px rgba(139,111,255,0.5),
      0 0 0 14px rgba(139,111,255,0.15),
      0 0 0 15px rgba(139,111,255,0.3),
      0 0 70px rgba(107,140,255,0.45),
      0 0 130px rgba(139,111,255,0.3),
      0 0 180px rgba(255,138,160,0.15);
    filter: brightness(1.12);
  }
  [data-state="speaking"] .orb-scaler { animation: orb-speak-pulse 0.9s ease-in-out infinite; }
  [data-state="speaking"] .ring-1 { animation: ring-speak 1s ease-out infinite 0s;    border-color: rgba(139,111,255,0.6); }
  [data-state="speaking"] .ring-2 { animation: ring-speak 1s ease-out infinite 0.28s; border-color: rgba(139,111,255,0.4); }
  [data-state="speaking"] .ring-3 { animation: ring-speak 1s ease-out infinite 0.56s; border-color: rgba(139,111,255,0.25); }

  /* — error — */
  [data-state="error"] .orb { filter: saturate(0.3) brightness(0.7); }

  /* — status area — */
  .idle-hint { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .idle-arrow { font-size: 22px; color: var(--muted); animation: arrow-bounce 1.6s ease-in-out infinite; display: block; }
  .idle-label { font-size: 16px; font-weight: 500; color: var(--fg); }

  .vs-status-area { display: flex; flex-direction: column; align-items: center; gap: 20px; min-height: 72px; }
  .vs-status { font-size: 15px; color: var(--muted); transition: opacity 0.3s ease; }
  [data-state="listening"] .vs-status,
  [data-state="speaking"]  .vs-status { color: var(--fg); }
  [data-state="error"] .vs-status { color: rgba(255,120,120,0.8); }

  .vs-end-btn {
    font-size: 12px;
    color: var(--muted);
    background: none;
    border: 0.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .vs-end-btn:hover { color: var(--fg); border-color: var(--fg); }

  @media (max-width: 900px) {
    .voice-section { padding: 64px 24px; }
    .vs-heading { font-size: 32px; letter-spacing: -0.8px; }
    .orb-scene { width: 240px; height: 240px; }
    .orb, .ring { width: 220px; height: 220px; }
  }

  /* ── Modo compacto: texto izquierda, esfera derecha, alto reducido.
        Estilos alineados con el sistema visual de Experiencia (Layout principal). ── */
  .voice-section[data-compact="true"] {
    padding: 3.5rem 5rem 3rem;
    border-bottom: 1px solid var(--hairline);
  }
  .voice-section[data-compact="true"] .vs-inner {
    max-width: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }
  .voice-section[data-compact="true"] .vs-orb-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .voice-section[data-compact="true"] .vs-intro {
    text-align: left;
    flex: 1;
    max-width: 60ch;
  }
  /* Eyebrow alineado con el resto de la página (uppercase + tracking) */
  .voice-section[data-compact="true"] .vs-eyebrow {
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }
  /* Heading alineado con .exp-title (Syne ya por global.css en h2) */
  .voice-section[data-compact="true"] .vs-heading {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    margin: 0 0 0.75rem;
  }
  /* Sub alineado con .exp-subtitle */
  .voice-section[data-compact="true"] .vs-sub {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0;
  }
  /* CTA alineado con .col-cta */
  .voice-section[data-compact="true"] .vs-cta {
    margin-top: 1.5rem;
    padding: 0.6rem 1.3rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--fg);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .voice-section[data-compact="true"] .vs-cta:hover {
    background-color: var(--surface);
    border-color: var(--fg);
  }
  .voice-section[data-compact="true"] .orb-scene {
    width: 150px;
    height: 150px;
  }
  .voice-section[data-compact="true"] .orb,
  .voice-section[data-compact="true"] .ring {
    width: 130px;
    height: 130px;
  }
  .voice-section[data-compact="true"] .vs-status-area {
    min-height: 0;
    gap: 10px;
  }
  .voice-section[data-compact="true"] .idle-arrow {
    font-size: 16px;
    color: var(--muted);
  }
  .voice-section[data-compact="true"] .idle-label {
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 500;
  }
  .voice-section[data-compact="true"] .vs-status {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .voice-section[data-compact="true"] {
      padding: 3rem 1.5rem;
    }
    .voice-section[data-compact="true"] .vs-inner {
      flex-direction: column;
      gap: 2.25rem;
    }
    .voice-section[data-compact="true"] .vs-intro { text-align: center; max-width: none; }
    .voice-section[data-compact="true"] .vs-sub { margin: 0 auto; }
    .voice-section[data-compact="true"] .vs-cta { margin-top: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb, .orb-scaler, .ring { animation: none !important; }
  }
</style>
