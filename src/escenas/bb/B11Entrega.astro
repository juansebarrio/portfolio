---
/**
 * src/escenas/bb/B11Entrega.astro — E11 · La entrega.
 *
 * El plan contra lo que pasó: cuatro fechas del build que se encienden al
 * quedar en el centro de la pantalla (data-focus-row: la fecha mono pasa a
 * musgo y el texto a tinta), y debajo el párrafo de la segunda etapa. A la
 * derecha, el bloque de los primeros usuarios entra desde la derecha
 * (data-reveal="right"). Misma mecánica de filas que A2Pedido / A7Metodo
 * de AURE, con el bloque de datos de B8Cultural.
 *
 * Las fechas y el texto salen de copy.ts (e11.timeline); según el README
 * del handoff (§7) las fechas quedan a confirmar por Juan.
 */
import { COPY, type Lang } from './copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang].e11;
---

<section
  id="e11"
  data-scene="10"
  data-screen-label="E11 · La entrega"
  aria-label={c.aria}
  class="bb-scene gap-[clamp(28px,3.6vw,44px)]"
>
  {/* ── Eyebrow y título ── */}
  <div class="flex flex-col gap-[clamp(14px,1.8vw,20px)]">
    <span data-reveal class="bb-eyebrow">{c.eyebrow}</span>
    <h2 data-reveal data-reveal-delay="0.1" class="max-w-[22ch] text-h3 text-pretty">{c.h2}</h2>
  </div>

  <div class="flex flex-wrap items-start gap-[clamp(26px,3.6vw,56px)]">
    {/* ── Izquierda: la línea de tiempo + la segunda etapa ── */}
    <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-[clamp(20px,2.6vw,30px)]">
      <div class="flex flex-col">
        {
          c.timeline.map((hito, i) => (
            <div
              data-focus-row
              data-reveal
              data-reveal-delay={(0.1 + i * 0.12).toFixed(2)}
              class:list={[
                'bb-row gap-[clamp(16px,3vw,36px)] py-[clamp(14px,1.8vw,20px)]',
                i === c.timeline.length - 1 && 'border-b border-hairline',
              ]}
            >
              <span class="min-w-[9ch] flex-none font-money text-[13px] text-tertiary">{hito.date}</span>
              <span class="text-[clamp(17px,2vw,24px)]/[1.34] text-ink">{hito.text}</span>
            </div>
          ))
        }
      </div>

      <p
        data-reveal
        data-reveal-delay="0.56"
        class="max-w-[56ch] text-[clamp(15px,1.7vw,18px)]/[1.5] text-secondary text-pretty"
      >
        {c.copy}
      </p>
    </div>

    {/* ── Derecha: los primeros usuarios ── */}
    <div
      data-reveal="right"
      data-reveal-delay="0.3"
      class="bb-bloque flex min-w-0 flex-[0_1_360px] flex-col gap-3.5 p-[clamp(20px,2.6vw,28px)]"
    >
      <span class="bb-eyebrow">{c.usersLabel}</span>
      <span class="text-[clamp(16px,1.7vw,19px)]/[1.45] text-ink text-pretty">{c.usersText}</span>
      <span class="border-t border-hairline pt-3.5 text-[clamp(14px,1.5vw,16px)]/[1.5] text-tertiary text-pretty">
        {c.usersNote}
      </span>
    </div>
  </div>
</section>
