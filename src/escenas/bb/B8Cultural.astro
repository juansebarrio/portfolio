---
/**
 * src/escenas/bb/B8Cultural.astro — E8 · La capa cultural.
 *
 * El método con el que Wided arma la capa cultural, en tres filas que se
 * encienden al quedar en el centro de la pantalla (data-focus-row: el
 * número pasa a musgo y el texto a tinta), y debajo las reglas contra el
 * estereotipo como chips neutras. A la derecha, el bloque de datos con
 * parallax (data-parallax) y el contador de voces en producción
 * (data-count + data-pulse): nace en 12 en el HTML y late al entrar.
 * Misma mecánica de filas que A2Pedido de AURE.
 */
import { COPY, type Lang } from './copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang].e8;
---

<section
  id="e8"
  data-scene="7"
  data-screen-label="E8 · La capa cultural"
  aria-label={c.aria}
  class="bb-scene gap-[clamp(26px,3.4vw,42px)]"
>
  {/* ── Eyebrow, título y copy ── */}
  <div class="flex flex-col gap-[clamp(14px,1.8vw,20px)]">
    <span data-reveal class="bb-eyebrow">{c.eyebrow}</span>
    <h2 data-reveal data-reveal-delay="0.1" class="max-w-[24ch] text-h3 text-pretty">{c.h2}</h2>
    <p data-reveal data-reveal-delay="0.18" class="bb-copy max-w-[64ch]">{c.copy}</p>
  </div>

  <div class="flex flex-wrap items-start gap-[clamp(26px,3.6vw,48px)]">
    {/* ── Izquierda: el método en tres filas + las reglas ── */}
    <div class="flex min-w-0 flex-[1_1_420px] flex-col">
      {
        c.rows.map((texto, i) => (
          <div
            data-focus-row
            data-reveal
            data-reveal-delay={(0.1 + i * 0.16).toFixed(2)}
            class:list={[
              'bb-row gap-[clamp(16px,3vw,36px)] py-[clamp(16px,2vw,22px)]',
              i === c.rows.length - 1 && 'border-b border-hairline',
            ]}
          >
            <span class="font-money text-[13px] text-tertiary">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[clamp(17px,2vw,24px)]/[1.34] text-ink text-pretty">{texto}</span>
          </div>
        ))
      }

      <div data-reveal data-reveal-delay="0.56" class="flex flex-col gap-2.5 pt-[clamp(18px,2.4vw,26px)]">
        <span class="font-money text-[11px] uppercase tracking-[0.16em] text-tertiary">{c.rulesLabel}</span>
        <div class="flex flex-wrap gap-2">
          {
            c.rules.map((regla) => (
              <span class="bb-chip-quiet px-3 py-2 text-[clamp(12px,1.35vw,14px)]">{regla}</span>
            ))
          }
        </div>
      </div>
    </div>

    {/* ── Derecha: voces en producción ── */}
    <div data-parallax="-0.06" class="min-w-0 flex-[0_1_300px]">
      <div
        data-reveal="right"
        data-reveal-delay="0.3"
        class="bb-bloque flex flex-col gap-3.5 p-[clamp(20px,2.6vw,28px)]"
      >
        <span class="bb-eyebrow">{c.statLabel}</span>
        <span class="flex items-baseline gap-3">
          <span
            data-count="12"
            data-pulse
            data-dur="1"
            class="bb-nums inline-block origin-left text-[clamp(44px,6vw,72px)]/[1] font-medium text-moss"
          >12</span>
          <span class="text-lead font-medium">{c.statUnit}</span>
        </span>
        <span class="text-[clamp(15px,1.6vw,17px)]/[1.45] text-secondary text-pretty">{c.statText}</span>
        <span class="bb-note border-t border-hairline pt-3.5">{c.statNote}</span>
      </div>
    </div>
  </div>
</section>
