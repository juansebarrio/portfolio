---
/**
 * src/escenas/bb/B9Visual.astro — E9 · Lo visual.
 *
 * La home de bb. recreada en HTML dentro del panel verde: la marca que mira
 * y parpadea, el hero en Petrona, el ejemplo del carrusel y la tarjeta de
 * papel con el campo vacío y el botón en su estado inicial. Al lado, la
 * cita de Wided al ver el prototipo; abajo, las tres claves del diseño.
 *
 * Mecánica: reveals escalonados (el panel entra en `scale`, la cita desde
 * la derecha) y parallax opuesto en las dos columnas. Los textos del
 * producto salen de PRODUCT (inglés en ambos idiomas); el resto de
 * COPY[lang].e9.
 */
import Marca from './Marca.astro';
import { COPY, PRODUCT, type Lang } from './copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang].e9;

/** Puntos del carrusel de ejemplos de la home: solo el primero está activo. */
const DOTS = 5;
---

<section
  id="e9"
  data-scene="8"
  data-screen-label="E9 · Lo visual"
  aria-label={c.aria}
  class="bb-scene gap-[clamp(26px,3.4vw,42px)]"
>
  <div class="flex flex-col gap-[clamp(14px,1.8vw,20px)]">
    <span data-reveal class="bb-eyebrow">{c.eyebrow}</span>
    <h2 data-reveal data-reveal-delay="0.1" class="max-w-[22ch] text-h3 text-pretty">
      {c.h2}
    </h2>
    <p data-reveal data-reveal-delay="0.18" class="bb-copy max-w-[64ch]">
      {c.copy}
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-[clamp(26px,3.6vw,48px)]">
    {/* ── La home recreada: el panel verde con la tarjeta de papel ── */}
    <div data-parallax="0.04" class="min-w-0 flex-[1_1_400px]">
      <div
        data-reveal="scale"
        data-reveal-delay="0.2"
        class="bb-panel flex w-full flex-col gap-[clamp(22px,2.8vw,32px)] p-[clamp(20px,2.6vw,30px)] font-bb-ui text-bb-paper"
      >
        {/* Header: la marca mirando y las dos líneas del menú */}
        <div class="flex items-center justify-between gap-3">
          <span class="flex items-center">
            <Marca size={32} eyes={15} gaze="looking" field />
          </span>
          <span aria-hidden="true" class="flex flex-col items-end gap-1.5">
            <span class="block h-[1.5px] w-6 bg-bb-paper"></span>
            <span class="block h-[1.5px] w-[15px] bg-bb-lime"></span>
          </span>
        </div>

        {/* Hero, apoyo y el ejemplo del carrusel */}
        <div class="flex flex-col gap-3.5">
          <span class="font-bb-serif text-[clamp(26px,3vw,36px)]/[1.08] tracking-[-0.02em] text-pretty">
            {PRODUCT.hero}
          </span>
          <span class="max-w-[420px] text-[14px]/[1.6] text-bb-sage text-pretty">
            {PRODUCT.support}
          </span>
          <div class="flex max-w-[440px] flex-col gap-2.5 border-t border-[rgba(250,246,238,.18)] pt-4">
            <span aria-hidden="true" class="flex items-center gap-1.5">
              {
                Array.from({ length: DOTS }, (_, i) => (
                  <span
                    class:list={[
                      'block h-[5px] w-[5px] rounded-full',
                      i === 0 ? 'bg-bb-lime' : 'bg-[rgba(250,246,238,.3)]',
                    ]}
                  />
                ))
              }
            </span>
            <span class="font-bb-serif text-[15px]/[1.5] italic text-bb-mist text-pretty">
              {PRODUCT.example}
            </span>
          </div>
        </div>

        {/* La tarjeta de papel: el campo vacío y el botón en estado inicial */}
        <div
          class="bb-card flex flex-col gap-2.5 rounded-[18px] p-[clamp(18px,2.4vw,26px)] shadow-[0_18px_40px_rgba(0,0,0,.28)]"
        >
          <span class="text-[14px]/[20px] font-medium">{PRODUCT.tell}</span>
          <span class="block min-h-[88px] border-b border-bb-paper-line"></span>
          <span
            class="mt-3 flex h-[50px] items-center justify-center gap-2.5 rounded-full bg-bb-paper-line text-[14px] font-medium text-bb-olive"
          >
            <span>{PRODUCT.cta}</span>
            <span aria-hidden="true">→</span>
          </span>
          <span class="text-[12px]/[1.55] text-bb-olive text-pretty">{PRODUCT.privacyNote}</span>
        </div>
      </div>
    </div>

    {/* ── La cita de Wided al ver el prototipo ── */}
    <div data-parallax="-0.07" class="min-w-0 flex-[0_1_280px]">
      <div
        data-reveal="right"
        data-reveal-delay="0.3"
        class="flex flex-col gap-3 border-l border-moss py-[clamp(6px,1vw,10px)] pl-[clamp(18px,2.4vw,26px)]"
      >
        <span class="font-money text-[clamp(20px,2.6vw,30px)]/[1.2] font-medium tracking-[0.06em]">
          {c.quote}
        </span>
        <span class="font-money text-[12px] uppercase tracking-[0.14em] text-tertiary">
          {c.quoteBy}
        </span>
      </div>
    </div>
  </div>

  {/* ── Las tres claves ── */}
  <div
    class="grid gap-[clamp(20px,2.6vw,36px)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))]"
  >
    {
      c.claves.map((k, i) => (
        <div
          data-reveal
          data-reveal-delay={(0.1 + i * 0.12).toFixed(2)}
          class="flex flex-col gap-2 border-t border-hairline pt-[clamp(14px,1.8vw,18px)]"
        >
          <span class="text-lead font-medium">{k.title}</span>
          <span class="text-[clamp(15px,1.6vw,17px)]/[1.45] text-secondary text-pretty">
            {k.text}
          </span>
        </div>
      ))
    }
  </div>
</section>
