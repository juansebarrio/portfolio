---
/**
 * E3 · La tesis.
 *
 * La frase se enciende palabra por palabra con el scroll
 * (data-scroll-words): es el único momento de la pieza donde el
 * movimiento sigue al dedo del lector y no a un reloj.
 */
const PALABRAS = [
  'El', 'diferencial', 'de', 'AURE', 'no', 'era', 'el', 'precio:', 'era', 'el',
];
---

<section
  id="e3"
  data-scene="2"
  data-screen-label="E3 · La tesis"
  aria-label="La tesis"
  class="aure-scene gap-[clamp(26px,3.4vw,40px)]"
>
  <p data-scroll-words class="flex max-w-[22ch] flex-wrap gap-x-[0.28em] gap-y-0 text-tesis">
    {PALABRAS.map((p) => <span>{p}</span>)}
    <span class="text-gold">profesionalismo.</span>
  </p>

  <div class="h-px max-w-[520px] bg-hairline-soft">
    <div data-hbar class="h-full bg-hairline" style="width:100%"></div>
  </div>
</section>
