# Password protection for /portfolio/*
# Copy this file to .env and fill in real values.
# Also add both variables to Vercel dashboard (Project Settings → Environment Variables).

# La contraseña que compartís por email (usar un valor real solo en .env / Vercel)
PORTFOLIO_PASSWORD=changeme

# Secret aleatorio para firmar cookies de sesión (NO compartir)
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTFOLIO_AUTH_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
